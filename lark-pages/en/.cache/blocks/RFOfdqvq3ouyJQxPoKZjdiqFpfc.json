n":1,"folded":false}}},{"block_id":"doxjpVObmfIchdk4uxs2iAiHeIf","block_type":2,"parent_id":"RFOfdqvq3ouyJQxPoKZjdiqFpfc","text":{"elements":[{"text_run":{"content":"A: ","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":"First, go to Cash Management > App Config > Supported Bank Setups and Cash Management > App Config > Bank Card - Country/Region to check whether the card's attribute information is correctly maintained. If it is correctly maintained but still not found, it might be because the bank card from that country is not supported due to policy and regulatory restrictions.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}}]}