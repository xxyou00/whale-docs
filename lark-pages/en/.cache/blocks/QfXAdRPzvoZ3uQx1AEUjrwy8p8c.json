FVGjfYusVMBg","text":{"elements":[{"text_run":{"content":" Q: ","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":"Is wallet address verification mandatory before depositing cryptocurrency?","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"doxjpJkrU8Xcw2hP22GeZ5ZetQb","block_type":2,"parent_id":"QfXAdRPzvoZ3uQx1AEUjrwy8p8c","text":{"elements":[{"text_run":{"content":"A: ","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":"Yes. Before any cryptocurrency deposit, the wallet address used by the client must first be verified. Unverified addresses cannot receive cryptocurrencies.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"doxjpJNCgck88YxrZBxWsn6Llef","block_type":19,"callout":{"background_color":5,"border_color":5,"emoji_id":"round_pushpin","text_color":1},"children":["doxjpz73LmdMh7rcTSmyyDBxkNh"],"parent_id":"QfXAdRPzvoZ3uQx1AEUjrwy8p8c"},{"block_id":"doxjpz73LmdMh7rcTSmyyDBxkNh","block_type":2,"parent_id":"doxjpJNCgck88YxrZBxWsn6Llef","text":{"elements":[{"text_run":{"content":" Q: ","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":"What verification methods are currently supported for wallet addresses?","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"doxjpgXX1Xz12Kzn4llqluFgQ7b","block_type":2,"parent_id":"QfXAdRPzvoZ3uQx1AEUjrwy8p8c","text":{"elements":[{"text_run":{"content":"A: ","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":"Currently, only micropayment verification is supported. The client must complete a small cryptocurrency payment to a designated address to confirm ownership of the wallet.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"doxjpi6XzRaEs01FkfGjjgzmq5f","block_type":19,"callout":{"background_color":5,"border_color":5,"emoji_id":"round_pushpin","text_color":1},"children":["doxjppUxHqJNpNt6k9nscpGiCQc"],"parent_id":"QfXAdRPzvoZ3uQx1AEUjrwy8p8c"},{"block_id":"doxjppUxHqJNpNt6k9nscpGiCQc","block_type":2,"parent_id":"doxjpi6XzRaEs01FkfGjjgzmq5f","text":{"elements":[{"text_run":{"content":"Q: ","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":"Once a wallet address is verified, can it be used for deposits of all cryptocurrencies?","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"doxjpfGnTuVEgtVTTEyU4EdoWsb","block_type":2,"parent_id":"QfXAdRPzvoZ3uQx1AEUjrwy8p8c","text":{"elements":[{"text_run":{"content":"A: ","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":"In most cases, a verified address can be used across all supported cryptocurrencies. However, certain cryptocurrencies require separate verification. Please follow the on-screen prompts for guidance specific to the cryptocurrency in question.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"doxjpun9Hz5YGiknhjF59y7c0Tg","block_type":19,"callout":{"background_color":5,"border_color":5,"emoji_id":"round_pushpin","text_color":1},"children":["doxjp9rEhjxNW2HRPEdbclJGeDe"],"parent_id":"QfXAdRPzvoZ3uQx1AEUjrwy8p8c"},{"block_id":"doxjp9rEhjxNW2HRPEdbclJGeDe","block_type":2,"parent_id":"doxjpun9Hz5YGiknhjF59y7c0Tg","text":{"elements":[{"text_run":{"content":"Q: ","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":"A client's wallet address is already verified, but micropayment verification is still being triggered for deposits of a particular cryptocurrency. Why?","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"doxjphWBEfRMNup0BXV6KHp1Ruh","block_type":2,"parent_id":"QfXAdRPzvoZ3uQx1AEUjrwy8p8c","text":{"elements":[{"text_run":{"content":"A: ","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":"Due to the specific nature of that cryptocurrency, each deposit requires a new micropayment verification to ensure fund security.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"doxjp1zhsTCvMuCRHqVnqpsCxee","block_type":19,"callout":{"background_color":5,"border_color":5,"emoji_id":"round_pushpin","text_color":1},"children":["doxjpqB4ZYEjtYOY0UQBAyTHlVh"],"parent_id":"QfXAdRPzvoZ3uQx1AEUjrwy8p8c"},{"block_id":"doxjpqB4ZYEjtYOY0UQBAyTHlVh","block_type":2,"parent_id":"doxjp1zhsTCvMuCRHqVnqpsCxee","text":{"elements":[{"text_run":{"content":"Q: ","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":"What should the client do if a \"Payment Failed\" error appears during the verification process?","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"doxjp6Um