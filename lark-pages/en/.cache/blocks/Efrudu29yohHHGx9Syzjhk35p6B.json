"underline":false}}},{"text_run":{"content":"sidebar_position: 0","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"language":67,"wrap":false}},"parent_id":"Efrudu29yohHHGx9Syzjhk35p6B"},{"block_id":"doxjpu9FbC5qyrCEg4uStfFYsdj","block_type":3,"heading1":{"elements":[{"text_run":{"content":"System Introduction","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"Efrudu29yohHHGx9Syzjhk35p6B"},{"block_id":"doxjpDeaJelTlbj7C97RN5fjYfc","block_type":3,"heading1":{"elements":[{"text_run":{"content":"I. System Overview","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"Efrudu29yohHHGx9Syzjhk35p6B"},{"block_id":"doxjpzwScuLfrQyhUI8mUNwdPGe","block_type":2,"parent_id":"Efrudu29yohHHGx9Syzjhk35p6B","text":{"elements":[{"text_run":{"content":"When clients use the Deposit Cryptocurrency and Withdraw Cryptocurrency features, the wallet addresses they use must undergo verification and whitelisting processes.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"doxjplbGcQoSgDFBjO5Fn9qLhpf","block_type":2,"parent_id":"Efrudu29yohHHGx9Syzjhk35p6B","text":{"elements":[{"text_run":{"content":"The wallet address verification workflow may vary depending on the platform and wallet type. The following describes the process using HashKey Exchange as an example.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"doxjp6LjyCM2phH7ApIw9mWYYTb","block_type":5,"heading3":{"elements":[{"text_run":{"content":"Preparations","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"Efrudu29yohHHGx9Syzjhk35p6B"},{"block_id":"doxjpz82GCiTDvRkJidbhVlRmbb","block_type":2,"parent_id":"Efrudu29yohHHGx9Syzjhk35p6B","text":{"elements":[{"text_run":{"content":"Confirm that the client's personal wallet supports message signing. Generally, HashKey Exchange does not restrict wallet types. Commonly supported options include software wallets such as MetaMask, Electrum, and MyEtherWallet, as well as hardware wallets such as Ledger Nano S and Trezor.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"doxjpDWpOlFMgd3uxQ6aPzC8the","block_type":5,"heading3":{"elements":[{"text_run":{"content":"Operation steps","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"Efrudu29yohHHGx9Syzjhk35p6B"},{"block_id":"doxjpC264PPd9bpE7ZI17jOKOQf","block_type":13,"ordered":{"elements":[{"text_run":{"content":"Trigger Address Verification: ","text_element_style":{"bold":true,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":"When a deposit is initiated, if the client's source address is a personal wallet that has not been verified by HashKey PRO, address verification will be triggered automatically once the client's virtual assets reach the required number of blockchain confirmations.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false,"sequence":"auto"}},"parent_id":"Efrudu29yohHHGx9Syzjhk35p6B"},{"block_id":"doxjpZpcaWkI1a2FjgVcrmZzTve","block_type":13,"ordered":{"elements":[{"text_run":{"content":"Choose Verification Method: ","text_element_style":{"bold":true,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":"Taking the Metamask wallet as an example, on the Add Deposit Whitelist page, the client should select the MetaMask verification method and click Connect MetaMask.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false,"sequence":"auto"}},"parent_id":"Efrudu29yohHHGx9Syzjhk35p6B"},{"block_id":"doxjpwPakAybljcSBtaO7C96Joc","block_type":13,"ordered":{"elements":[{"text_run":{"content":"Connect Wallet: ","text_element_style":{"bold":true,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":"A wallet connection interface will pop up. The client should confirm the wallet address to be verified, click Next, and then click Connect","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":".","text_element_style":{"bold":true,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false,"sequence":"auto"}},"parent_id":"Efrudu29yohHHGx9Syzjhk35p6B"},{"block_id":"doxjpP9Fphe44q0GqvF0RxDQ89d","block_type":13,"ordered":{"elements":[{"text_run":{"content":"Micropayment Verification:","text_element_style":{"bold":true,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":" On the Customer Wallet Address page, the client should click Add Verification, accurately fill in information such as the wallet address to be verified and the corresponding cryptocurrency, review the information, and then submit it. Next, the client should log in to their personal cryptocurrency wallet and transfer the specified Verification Amount to the system-generated Verification Address.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false,"sequence":"auto"}},"parent_id":"Efrudu29yohHHGx9Syzjhk35p6B"},{"block_id":"doxjpwmfgOFk6TkVj7QvoA3Fzuc","block_type":13,"ordered":{"elements":[{"text_run":{"content":"Complete Verification: ","text_element_style":{"bold":true,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":"Once the micropayment is confirmed, the address is added to the deposit whitelist. For subsequent deposits, the client can directly select this address without verification again.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false,"sequence":"auto"}},"parent_id":"Efrudu29yohHHGx9Syzjhk35p6B"},{"block_id":"doxjpOmvbEfKrT2kC8jUBjF4o8f","block_type":3,"heading1":{"elements":[{"text_run":{"content":"II. ","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":"Operation Instructions","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"Efrudu29yohHHGx9Syzjhk35p6B"},{"block_id":"doxjpNTrsZ9G1H1HXdBbiShe7Pf","block_type":4,"heading2":{"elements":[{"text_run":{"content":"Permission Preparations","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"Efrudu29yohHHGx9Syzjhk35p6B"},{"block_id":"doxjpxxrHOJBez6DAqPo3VPQoeh","block_type":2,"parent_id":"Efrudu29yohHHGx9Syzjhk35p6B","text":{"elements":[{"text_run":{"content":"Back office operators log in to WBO and confirm that they have obtained the operation permissions for Cryptocurrency, Channel Custodial Account, and Client Wallet Address. Operators who have not been granted the required permissions should contact the administrator to request access.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"doxjpsU52O04LYax8gIjof7jO0H","block_type":4,"heading2":{"elements":[{"text_run":{"content":"Preparation: Cryptocurrency Data Maintenance (First Step for All Operations)","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"Efrudu29yohHHGx9Syzjhk35p6B"},{"block_id":"doxjp8QaLdJcWerMb0hhKUc1Vpb","block_type":19,"callout":{"background_color":5,"border_color":5,"emoji_id":"round_pushpin","text_color":1},"children":["doxjpZIPnUjZSJFfydn1YnGHoQc"],"parent_id":"Efrudu29yohHHGx9Syzjhk35p6B"},{"block_id":"doxjpZIPnUjZSJFfydn1YnGHoQc","block_type":2,"parent_id":"doxjp8QaLdJcWerMb0hhKUc1Vpb","text":{"elements":[{"text_run":{"content":"Navigation: WBO > Service Parameter > Fund Parameter > Cryptocurrency","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"doxjpev9oSQHbGoDfxUaovkNdWd","block_type":2,"parent_id":"Efrudu29yohHHGx9Syzjhk35p6B","text":{"elements":[{"text_run":{"content":"Before conducting cryptocurrency deposits/withdrawals and wallet address verification, back office operators must first complete the maintenance of relevant cryptocurrency data:","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"doxjphYqET1BrUf5SmJgcRh1Z70","block_type":13,"ordered":{"elements":[{"text_run":{"content":"Log in to WBO and go to Service Parameter > Fund Parameter > Cryptocurrency.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false,"sequence":"1"}},"parent_id":"Efrudu29yohHHGx9Syzjhk35p6B"},{"block_id":"doxjp7AvCjY95ewlaeybJgu4bpg","block_type":13,"ordered":{"elemen