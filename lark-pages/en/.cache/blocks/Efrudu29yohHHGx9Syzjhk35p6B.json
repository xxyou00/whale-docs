text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"doxjpqZFjcGwgDVzfL4fo8KYLBd","block_type":13,"ordered":{"elements":[{"text_run":{"content":"Go to VA Clearing Management > Deposit & Withdrawal > Channel Custodial Account.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false,"sequence":"1"}},"parent_id":"Efrudu29yohHHGx9Syzjhk35p6B"},{"block_id":"doxjpjJRVO5mDjrekxQE2lw5zhc","block_type":13,"ordered":{"elements":[{"text_run":{"content":"Click Bulk creation and upload the reviewed channel custodial account list (must conform to the system-specified format).","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false,"sequence":"auto"}},"parent_id":"Efrudu29yohHHGx9Syzjhk35p6B"},{"block_id":"doxjpGTji9eLkO2rZ2vMfUroPLg","block_type":13,"ordered":{"elements":[{"text_run":{"content":"After the import is completed, verify that the account information is correct and click Confirm. These accounts are used for automatic assignment before client verification.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false,"sequence":"auto"}},"parent_id":"Efrudu29yohHHGx9Syzjhk35p6B"},{"block_id":"KwNqd82hDo4EU9xwwjZjN56Epye","block_type":27,"image":{"align":2,"height":1298,"scale":1,"token":"IVxXb8zUToFpzaxNPC3jLfIcpMh","width":2480},"parent_id":"Efrudu29yohHHGx9Syzjhk35p6B"},{"block_id":"doxjpyDnM2W6xVuspu4JIuj3kQg","block_type":4,"heading2":{"elements":[{"text_run":{"content":"Verification Record Monitoring","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"Efrudu29yohHHGx9Syzjhk35p6B"}