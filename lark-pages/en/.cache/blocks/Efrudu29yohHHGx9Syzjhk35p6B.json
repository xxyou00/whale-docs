ch).","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false,"sequence":"auto"}},"parent_id":"Efrudu29yohHHGx9Syzjhk35p6B"},{"block_id":"O3VSdNOHFogB3Vxc65OjFhcOprg","block_type":27,"image":{"align":2,"height":1160,"scale":1,"token":"X7dNb8Z3VoinIixejMpj2wfapve","width":2446},"parent_id":"Efrudu29yohHHGx9Syzjhk35p6B"},{"block_id":"doxjpkv83GiHAf68cfMHVZFemch","block_type":4,"heading2":{"elements":[{"text_run":{"content":"Whitelisting and Subsequent Management","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"Efrudu29yohHHGx9Syzjhk35p6B"},{"block_id":"doxjprisniXSsLWQyz7V0vlPt6g","block_type":19,"callout":{"background_color":5,"border_color":5,"emoji_id":"round_pushpin","text_color":1},"children":["doxjpXh0q1YV7uWRc1iuWsSMuLb"],"parent_id":"Efrudu29yohHHGx9Syzjhk35p6B"},{"block_id":"doxjpXh0q1YV7uWRc1iuWsSMuLb","block_type":2,"parent_id":"doxjprisniXSsLWQyz7V0vlPt6g","text":{"elements":[{"text_run":{"content":" ","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":"Navigation: WBO > VA Clearing Management > Deposit & Withdrawal > Client Wallet Address","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"doxjpzEw47NkBFdpmkO9oh10vLf","block_type":13,"ordered":{"elements":[{"text_run":{"content":"After a client's address is verified, the system automatically adds it to the whitelist. Operators can view all whitelisted addresses in the back office.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false,"sequence":"1"}},"parent_id":"Efrudu29yohHHGx9Syzjhk35p6B"},{"block_id":"doxjp3J1wuFGpuo9GzdfU6h14ih","block_type":13,"ordered":{"elements":[{"text_run":{"content":"Operators may manage whitelisted address statuses as needed — for example, removing addresses to mitigate exception risks.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false,"sequence":"auto"}},"parent_id":"Efrudu29yohHHGx9Syzjhk35p6B"},{"block_id":"doxjpQpjWvIK5n3grPn9SPNvwVc","block_type":13,"ordered":{"elements":[{"text_run":{"content":"Operators should regularly export verification and whitelisting records for compliance filing and data archiving.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false,"sequence":"auto"}},"parent_id":"Efrudu29yohHHGx9Syzjhk35p6B"},{"block_id":"JEb6dCpj2oqeXvxSkmCjsbxQplb","block_type":27,"image":{"align":2,"height":1172,"scale":1,"token":"XWJ1bmawzoJ9nExJ2lqj96ekpWb","width":2464},"parent_id":"Efrudu29yohHHGx9Syzjhk35p6B"},{"block_id":"doxjpxjvoUq0uFAQMLeMEu4YaKh","block_type":4,"heading2":{"elements":[{"text_run":{"content":"Precautions","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"Efrudu29yohHHGx9Syzjhk35p6B"},{"block_id":"doxjpKPSLqJMXgLJtO6aQrVW5jg","block_type":13,"ordered":{"elements":[{"text_run":{"content":"Clients must submit their own wallet address for verification. Using another person's address may result in funds not being credited correctly.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false,"sequence":"1"}},"parent_id":"Efrudu29yohHHGx9Syzjhk35p6B"},{"block_id":"doxjpkQL5NByiyXMqakhmbEvJvf","block_type":13,"ordered":{"elements":[{"text_run":{"content":"The funds used for micropayment verification are solely for identity verification purposes. No fees are charged, and there is no need to withdraw these funds separately after verification is complete.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false,"sequence":"auto"}},"parent_id":"Efrudu29yohHHGx9Syzjhk35p6B"},{"block_id":"doxjpLzpPlOvAcOPKXHT0JbKxLc","block_type":13,"ordered":{"elements":[{"text_run":{"content":"Operators should properly keep operation records and transfer receipts generated during the verification process to facilitate future troubleshooting.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false,"sequence":"auto"}},"parent_id":"Efrudu29yohHHGx9Syzjhk35p6B"},{"block_id":"doxjp8SM9TQqTCyolG7xOKZ9c2f","block_type":13,"ordered":{"elements":[{"text_run":{"content":"If a system error occurs — such as a page failing to load or a submission error — refresh the page or try a different browser. If the issue persists, contact the technical support team.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false,"sequence":"auto"}},"parent_id":"Efrudu29yohHHGx9Syzjhk35p6B"},{"block_id":"doxjpdtLvxdg7zQrvedmTz0DJqp","block_type":13,"ordered":{"elements":[{"text_run":{"content":"Operators shall strictly comply with relevant cryptocurrency business regulations and platform rules. Falsified verifications will result in account restrictions; serious violations may result in termination of services.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false,"sequence":"auto"}},"parent_id":"Efrudu29yohHHGx9Syzjhk35p6B"}]}