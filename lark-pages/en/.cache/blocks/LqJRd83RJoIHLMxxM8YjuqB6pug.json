","block_type":2,"parent_id":"LqJRd83RJoIHLMxxM8YjuqB6pug","text":{"elements":[{"text_run":{"content":"Cryptocurrency withdrawal refers to the process of a client transferring cryptocurrency held in a trading platform or personal wallet to an external target address (such as another trading platform account/wallet or another person's receiving address). Its core features and scenarios are as follows:","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"doxjpQEj5kD3MWEVgFhwwiEnagb","block_type":12,"bullet":{"elements":[{"text_run":{"content":"Business Nature: ","text_element_style":{"bold":true,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":"A cryptocurrency withdrawal transfers digital asset ownership between addresses by broadcasting a transaction to the blockchain network. The process relies on a dual-layer security mechanism consisting of platform review and on-chain confirmation.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"LqJRd83RJoIHLMxxM8YjuqB6pug"},{"block_id":"doxjpsR5c8wuEehBJskFtZx8zMU","block_type":12,"bullet":{"elements":[{"text_run":{"content":"Common Scenarios: ","text_element_style":{"bold":true,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":"Asset transfers between platforms; personal custody (e.g., transferring to a hardware wallet); payment to a third party; or converting to fiat currency by first transferring to a platform that supports fiat withdrawals.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"LqJRd83RJoIHLMxxM8YjuqB6pug"},{"block_id":"doxjpsbmh1dohUtBFKkhEkShMCh","block_type":12,"bullet":{"elements":[{"text_run":{"content":"Key Rules: ","text_element_style":{"bold":true,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":"The selected blockchain network must match the cryptocurrency being withdrawn (e.g., ERC-20 or TRC-20 for USDT). Withdrawals are also subject to platform requirements such as KYC verification, withdrawal limits, and security checks.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"LqJRd83RJoIHLMxxM8YjuqB6pug"},{"block_id":"doxjpuvBV9PB3sZOdEA3Hz27kyh","block_type":3,"heading1":{"elements":[{"text_run":{"content":"Withdrawal Procedure","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"LqJRd83RJoIHLMxxM8YjuqB6pug"},{"block_id":"doxjpHy5lF7t20ixsVeByjX6i8c","block_type":2,"parent_id":"LqJRd83RJoIHLMxxM8YjuqB6pug","text":{"elements":[{"text_run":{"content":"Basic process for withdrawals:","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"doxjpb2jNtDmt0ieAueXtXmoWbd","block_type":13,"ordered":{"elements":[{"text_run":{"content":"Preparation: Confirm basic conditions.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false,"sequence":"auto"}},"parent_id":"LqJRd83RJoIHLMxxM8YjuqB6pug"},{"block_id":"doxjpjGfalmyDiJzB2vDYTIc03g","block_type":13,"ordered":{"elements":[{"text_run":{"content":"Initiate a withdrawal request (taking a trading platform as an example).","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false,"sequence":"auto"}},"parent_id":"LqJRd83RJoIHLMxxM8YjuqB6pug"},{"block_id":"doxjpX0anDAuoe4KNBCilXMYQ2b","block_type":13,"ordered":{"elements":[{"text_run":{"content":"Complete security check and submission.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false,"sequence":"auto"}},"parent_id":"LqJRd83RJoIHLMxxM8YjuqB6pug"},{"block_id":"doxjpSsmSE5mC5mrKymoDrGd3Cb","block_type":13,"ordered":{"elements":[{"text_run":{"content":"WBO work order approval process","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false,"sequence":"auto"}},"parent_id":"LqJRd83RJoIHLMxxM8YjuqB6pug"},{"block_id":"doxjpAcx8Y3bfJa5Y1X2zatG6qf","block_type":13,"ordered":{"elements":[{"text_run":{"content":"Wait for platform review and on-chain confirmation","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false,"sequence":"auto"}},"parent_id":"LqJRd83RJoIHLMxxM8YjuqB6pug"},{"block_id":"doxjplKDJUB73fPUpvC98eVSyxb","block_type":13,"ordered":{"elements":[{"text_run":{"content":"Confirm the receipt status.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false,"sequence":"auto"}},"parent_id":"LqJRd83RJoIHLMxxM8YjuqB6pug"},{"block_id":"doxjpWhVqrq5VdrerlpqtrA4zQh","block_type":19,"callout":{"background_color":5,"border_color":5,"emoji_id":"round_pushpin","text_color":1},"children":["doxjpsBVZyGjfc85UwUlp68RkGd"],"parent_id":"LqJRd83RJoIHLMxxM8YjuqB6pug"},{"block_id":"doxjpsBVZyGjfc85UwUlp68RkGd","block_type":2,"parent_id":"doxjpWhVqrq5VdrerlpqtrA4zQh","text":{"elements":[{"text_run":{"content":"Note: Virtual currency accounts are recorded as combined assets of \"cryptocurrency + quotation currency\". Deposits and withdrawals are recorded separately by cryptocurrency. When ultimately synchronized to the securities account, they are recorded under the combined asset (Example: ETH with a default quotation currency of USD would be recorded under the symbol VA/HAS/ETHUSD). During a withdrawal, the system will first deduct from the cryptocurrency with the largest available balance. If that balance is insufficient to cover the withdrawal amount, the system will automatically draw from the cryptocurrency with the second-largest balance.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}}]}