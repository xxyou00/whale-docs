omatically matching bank statement fields, such as the remitter's name, bank account number, currency, and amount, with existing deposit records for funding.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"IZnYdc9KaoYBQPxJTuhj9sTIpce","block_type":32,"children":["CgW8dh0Y3oBm5lxnK1VjCe1wp2e"],"parent_id":"NW3tdao0uompofxM267juuSypLe","table_cell":{}},{"block_id":"CgW8dh0Y3oBm5lxnK1VjCe1wp2e","block_type":2,"parent_id":"IZnYdc9KaoYBQPxJTuhj9sTIpce","text":{"elements":[{"text_run":{"content":"Deposit Refund","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"NlcgdXvzoo17vQxNfL2j46y3pme","block_type":32,"children":["JTlVd2v5qodHWWxYo2BjmZGIpfe"],"parent_id":"NW3tdao0uompofxM267juuSypLe","table_cell":{}},{"block_id":"JTlVd2v5qodHWWxYo2BjmZGIpfe","block_type":2,"parent_id":"NlcgdXvzoo17vQxNfL2j46y3pme","text":{"elements":[{"text_run":{"content":"This method is used when an deposit cannot be accepted due to uncompleted account opening, account flagged for risks, or other reasons, and funds need to be returned to the client's account.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"FuCCdLayloAVBKxX6vQjkEcWpRh","block_type":32,"children":["DZQZdE7vQoOb2KxAkynjstEBpRK"],"parent_id":"NW3tdao0uompofxM267juuSypLe","table_cell":{}},{"block_id":"DZQZdE7vQoOb2KxAkynjstEBpRK","block_type":2,"parent_id":"FuCCdLayloAVBKxX6vQjkEcWpRh","text":{"elements":[{"text_run":{"content":"Withdrawal Refund","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"JWQJdHSy2o6GCqxEvrCjktANp61","block_type":32,"children":["UcdDdV0hAoYxUzxyw5HjW4fdpyb"],"parent_id":"NW3tdao0uompofxM267juuSypLe","table_cell":{}},{"block_id":"UcdDdV0hAoYxUzxyw5HjW4fdpyb","block_type":2,"parent_id":"JWQJdHSy2o6GCqxEvrCjktANp61","text":{"elements":[{"text_run":{"content":"This method is used when a client's withdrawal is rejected by the beneficiary bank, and the funds are returned by the bank to the account, recorded as a bank inflow. This function allow the returned funds to be matched with the original account. (Since these returned funds appear as an inflow on the bank statement, they are managed on the Deposit Match page to ensure they are distinguished from regular deposits.)","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"doxjpjH43jjHKfERWs8ZICMRqCd","block_type":12,"bullet":{"elements":[{"text_run":{"content":"Link Checking: This page displays only those bank statement deposit entries that the system could not match automatically and therefore require manual review. Operators can follow the on-screen prompts to review each entry and proceed with subsequent deposit or other actions.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"children":["doxjps1Gho1fcRh0hnjEaTPe7lf","Vn9bdwbqfofreOxquLzjkeFZpah","I552dT7hToz7yJxp7N8j37CgpyD","EC9zdpacwoVrBxxrfpBj72MApmb"],"parent_id":"XDCMdNeGcoQG3Dx714IjyvkdpDe"},{"block_id":"doxjps1Gho1fcRh0hnjEaTPe7lf","block_type":12,"bullet":{"elements":[{"text_run":{"content":"The Link Checking page will automatically compare fields based on name matching (as shown in the figure). If the result is correct, click Link.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"doxjpjH43jjHKfERWs8ZICMRqCd"},{"block_id":"Vn9bdwbqfofreOxquLzjkeFZpah","block_type":24,"children":["C4U2dkLaookQzmxnL3SjsGwepRb","UFDXdQ3KQoXH29xJB1Kjhh69pab"],"grid":{"column_size":2},"parent_id":"doxjpjH43jjHKfERWs8ZICMRqCd"},{"block_id":"C4U2dkLaookQzmxnL3SjsGwepRb","block_type":25,"children":["NtHudUqkpo2DCjxssICjTfVwpdf"],"grid_column":{"width_ratio":41},"parent_id":"Vn9bdwbqfofreOxquLzjkeFZpah"},{"block_id":"NtHudUqkpo2DCjxssICjTfVwpdf","block_type":27,"image":{"align":2,"height":1946,"scale":0.2938808373590982,"token":"RiI5bDRr0oNCfMxxX0Lj9wDdpCh","width":2484},"parent_id":"C4U2dkLaookQzmxnL3SjsGwepRb"},{"block_id":"UFDXdQ3KQoXH29xJB1Kjhh69pab","block_type":25,"children":["DrFidzWmYoynqMxp0KEjm841pbg"],"grid_column":{"width_ratio":58},"parent_id":"Vn9bdwbqfofreOxquLzjkeFZpah"},{"block_id":"DrFidzWmYoynqMxp0KEjm841pbg","block_type":27,"image":{"align":2,"height":1434,"scale":0.2836052836052836,"token":"J0WKbaHClovxVfxSuIWjy9i5pHf","width":2574},"parent_id":"UFDXdQ3KQoXH29xJB1Kjhh69pab"},{"block_id":"I552dT7hToz7yJxp7N8j37CgpyD","block_type":12,"bullet":{"elements":[{"text_run":{"content":"If the system's suggested match is incorrect, click Customize to manually link the entry to the correct client. Manual linking can be performed using either a deposit application or a securities account.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"doxjpjH43jjHKfERWs8ZICMRqCd"},{"block_id":"EC9zdpacwoVrBxxrfpBj72MApmb","block_type":24,"children":["XhevdjMcioQjzGxQXhyjIt2dpKd","RGrodYGOIofMqExgbizj8c8qpGf"],"grid":{"column_size":2},"parent_id":"doxjpjH43jjHKfERWs8ZICMRqCd"},{"block_id":"XhevdjMcioQjzGxQXhyjIt2dpKd","block_type":25,"children":["PzcJdyYnCo9KF8x9oB3jUyxapBd"],"grid_column":{"width_ratio":50},"parent_id":"EC9zdpacwoVrBxxrfpBj72MApmb"},{"block_id":"PzcJdyYnCo9KF8x9oB3jUyxapBd","block_type":27,"image":{"align":2,"height":1756,"scale":0.23548387096774193,"token":"IJtwbU0OFoVjOKxhwgVj0kUwpoh","width":3100},"parent_id":"XhevdjMcioQjzGxQXhyjIt2dpKd"},{"block_id":"RGrodYGOIofMqExgbizj8c8qpGf","block_type":25,"children":["ThpjdGRIuo37IXx6R3Cjm0RKpuc"],"grid_column":{"width_ratio":49},"parent_id":"EC9zdpacwoVrBxxrfpBj72MApmb"},{"block_id":"ThpjdGRIuo37IXx6R3Cjm0RKpuc","block_type":27,"image":{"align":2,"height":1732,"scale":0.24092409240924093,"token":"LM9kbp5V5ostwaxcy2TjH0top1b","width":3030},"parent_id":"RGrodYGOIofMqExgbizj8c8qpGf"},{"block_id":"FvtAd3ihgoSV53xHRf3jTuGnp0f","block_type":2,"parent_id":"XDCMdNeGcoQG3Dx714IjyvkdpDe","text":{"elements":[{"text_run":{"content":"Deposit Refund: This function is used when a deposit fails to reach the client's securities account for any reason and a refund must be issued. The operator should enter the client's bank account details, confirm the details, and click OK. The record will then be routed to the deposit review page for approval.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"BGjld6OyfoIX0vx2W07jbn8JpKU","block_type":27,"image":{"align":2,"height":1871,"scale":1,"token":"R07abr1wno5d46xCGzfjz0BfpKD","width":3392},"parent_id":"XDCMdNeGcoQG3Dx714IjyvkdpDe"},{"block_id":"doxjpII7IFCJi5heHY4dde3tP9c","block_type":2,"parent_id":"XDCMdNeGcoQG3Dx714IjyvkdpDe","text":{"elements":[{"text_run":{"content":"Withdrawal Refund: The data on the Deposit Match page comes from inflows on bank statements, and a client withdrawal that has been rejected by the bank will appear as an inflow in the statement. The operator needs to link the withdrawal ID and process the entry using the Withdrawal Refund function.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"F5NcdERWQo5649xbJngjJ21Up1g","block_type":27,"image":{"align":2,"height":1760,"scale":1,"token":"LKVvbBFfEoMWbhxrUyDjUXpFpPg","width":3298},"parent_id":"XDCMdNeGcoQG3Dx714IjyvkdpDe"},{"block_id":"doxjpycwFkwcmTvzGkPElMjndEg","block_type":4,"heading2":{"elements":[{"text_run":{"content":"Deposit Review","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"XDCMdNeGcoQG3Dx714IjyvkdpDe"},{"block_id":"doxjpH26bw23Z82y48DzuIXXrSa","block_type":2,"parent_id":"XDCMdNeGcoQG3Dx714IjyvkdpDe","text":{"elements":[{"text_run":{"content":"After operators process inflows on bank statements on the Deposit Match page, the results are sent to downstream reviewers for approval. Funds are only deposited after approval. For normally linked deposits, there are cases where the client's securities account is still in the opening process at the time of deposit. The system will separately approve such records.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"doxjpYtyWjuA66874a5PEdEZrue","block_type":12,"bullet":{"elements":[{"text_run":{"content":"Opening: Select the target record, click Approve to enter the details page, recheck the information, and initiate a work order approval after confirmation.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"XDCMdNeGcoQG3Dx714IjyvkdpDe"},{"block_id":"M7SudYxOJoWTLIxEvbQjyvShpRf","block_type":27,"image":{"align":2,"height":1748,"scale":1,"token":"NLDsbfvbWouBZ8xuzTRjfS5Hpge","width":3310},"parent_id":"XDCMdNeGcoQG3Dx714IjyvkdpDe"},{"block_id":"doxjpjnOIu9luxc5jLo3PvO9sWh","block_type":12,"bullet":{"elements":[{"text_run":{"content":"Opened: Select the target record, click Approve to enter the details page, recheck the information, and approve directly after confirmation.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"XDCMdNeGcoQG3Dx714IjyvkdpDe"},{"block_id":"MIsMdLNm4ogvBAxLyiHjj47apod","block_type":27,"image":{"align":2,"height":1748,"scale":1,"token":"Amkkb1mWYo9ca9xxt0Dj1mvepLg","width":3310},"parent_id":"XDCMdNeGcoQG3Dx714IjyvkdpDe"},{"block_id":"doxjpvRI0woqNYpbXlUsMbhz6Sc","block_type":12,"bullet":{"elements":[{"text_run":{"content":"Deposit refund: Select the target record and click Approve to trigger the approval work order. Confirm the details and approve.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"XDCMdNeGcoQG3Dx714IjyvkdpDe"},{"block_id":"YqWKdGAosogvjZxWqnmj2MhvpSd","block_type":27,"image":{"align":2,"height":1762,"scale":1,"token":"P5LYbmCKQo0HHyxMvIujnZ4BpHb","width":3320},"parent_id":"XDCMdNeGcoQG3Dx714IjyvkdpDe"},{"block_id":"doxjpSWNYrRoQnX9rHNTV9Yof4e","block_type":12,"bullet":{"elements":[{"text_run":{"content":"Withdrawal refund: Select the target record, click Approve, and approve directly upon confirmation. No work order approval is required.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"XDCMdNeGcoQG3Dx714IjyvkdpDe"},{"block_id":"TokNdTirfoopVTxeQ6OjopcqpSe","block_type":27,"image":{"align":2,"height":1852,"scale":1,"token":"Km9YbtdHZonXdXxGOsmjTLLVpWq","width":3401},"parent_id":"XDCMdNeGcoQG3Dx714IjyvkdpDe"},{"block_id":"doxjpjvrcz7kIefCJiRPEagd3Dh","block_type":4,"heading2":{"elements":[{"text_run":{"content":"Deposits During Account Opening","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"XDCMdNeGcoQG3Dx714IjyvkdpDe"},{"block_id":"doxjpSxfkJqe8q9h0qfLlsf95PR","block_type":2,"parent_id":"XDCMdNeGcoQG3Dx714IjyvkdpDe","text":{"elements":[{"text_run":{"content":"Since","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":" the deposit and account opening workflows can be initiated in parallel, there are cases in which the deposit workflow has been approved while the account opening workflow is still in progress. ","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":"This page allows operators to monitor the account opening status corresponding to each approved deposit record.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"doxjpFCo3HsOp3xKV2kggbYthLg","block_type":2,"parent_id":"XDCMdNeGcoQG3Dx714IjyvkdpDe","text":{"elements":[{"text_run":{"content":"Operators can view the status of each record in the Account Opening Status column. If a client's account opening fails, click Reject to reject the associated deposit record (batch operations supported).","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"GhmYdqUmkoFNGgxhXkmjCUpgp9e","block_type":27,"image":{"align":2,"height":1122,"scale":1,"token":"Rw3OblWgzoktvixY9Lcj25j8pxe","width":3288},"parent_id":"XDCMdNeGcoQG3Dx714IjyvkdpDe"},{"block_id":"doxjp3w4FPtk4m1qXjMM0OJXYkw","block_type":4,"heading2":{"elements":[{"text_run":{"content":"Deposit Reconciliation","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"XDCMdNeGcoQG3Dx714IjyvkdpDe"},{"block_id":"doxjpzWV0jErD8dfksP7DirOHwq","block_type":2,"parent_id":"XDCMdNeGcoQG3Dx714IjyvkdpDe","text":{"elements":[{"text_run":{"content":"To ensure the accuracy of fund flows, business operations require comparing ","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":"bank statement entries","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":" with system deposit records to improve deposit accuracy. ","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":"There are two sources of bank statements:","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":" (1) API integration (automatic), and (2) manual import.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"doxjpxTQaWKQ0tITYiegWgxCagd","block_type":12,"bullet":{"elements":[{"text_run":{"content":"Reconciliation: ","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":"Operators can select the bank statement for the target period to refresh. The system will automatically match the bank statement entries with the system's deposit records. After reconciliation is complete, operators can check the results in the Reconciliation Results column. If inconsistencies are found, further investigation and handling are required.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"XDCMdNeGcoQG3Dx714IjyvkdpDe"},{"block_id":"UhCsdzJsDopagbxih2DjIKsXpQe","block_type":27,"image":{"align":2,"height":1496,"scale":1,"token":"ATF2bW9nAoFdLIxo5ecjNMcDp7f","width":3282},"parent_id":"XDCMdNeGcoQG3Dx714IjyvkdpDe"},{"block_id":"YotidDX8uoqy5bxaiEJj900UpTf","block_type":27,"image":{"align":2,"height":1732,"scale":1,"token":"LacLb6unJoORwNxl1A8je1Mzp2d","width":3290},"parent_id":"XDCMdNeGcoQG3Dx714IjyvkdpDe"},{"block_id":"doxjpfi0rBE5qDMElRUglE5gB7d","block_type":4,"heading2":{"elements":[{"text_run":{"content":"Deposit Records","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"XDCMdNeGcoQG3Dx714IjyvkdpDe"},{"block_id":"Voa3dSrIFohnb6xDh0ajoyyvpVg","block_type":2,"parent_id":"XDCMdNeGcoQG3Dx714IjyvkdpDe","text":{"elements":[{"text_run":{"content":"The Deposit Records page tracks the full process of deposits. Operators can query, export, and import records on this page at any time.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"doxjpqEhBdG6w9nOOJV6JrPDNXe","block_type":12,"bullet":{"elements":[{"text_run":{"content":"If operators did not enter bank statement information when using the Direct Deposit function, they can click Import bank statements to supplement bank statement information in batches on this page.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"XDCMdNeGcoQG3Dx714IjyvkdpDe"},{"block_id":"MddkdFqppo18P6xe2M4jiuQHp0g","block_type":27,"image":{"align":2,"height":1458,"scale":1,"token":"LHlvbv9IyoosAqxgknCjoAISp9g","width":3784},"parent_id":"XDCMdNeGcoQG3Dx714IjyvkdpDe"},{"block_id":"doxjpZKWCsQI4ph4dJ9xjHImEXf","block_type":3,"heading1":{"elements":[{"text_run":{"content":"3. FAQ","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"XDCMdNeGcoQG3Dx714IjyvkdpDe"},{"block_id":"doxjplyBsI3YD072CPnRnGqq60S","block_type":2,"parent_id":"XDCMdNeGcoQG3Dx714IjyvkdpDe","text":{"elements":[{"text_run":{"content":"Q: What are the deposit methods and channels?","text_element_style":{"bold":false,"inli