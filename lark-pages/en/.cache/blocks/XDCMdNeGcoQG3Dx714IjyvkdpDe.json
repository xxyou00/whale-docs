text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":"bank statement","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":", deposit review, separate processing of deposits during account opening, reconciliation, and deposit record queries. To satisfy ","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":"compliance","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":" and risk-control requirements, the ","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":"system's","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":" design features multi-role, workflow-driven capabilities that balance high deposit efficiency with low financial risk.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"doxjpZrMsZ46XiGw9Aqh3t3BJ5d","block_type":2,"parent_id":"XDCMdNeGcoQG3Dx714IjyvkdpDe","text":{"elements":[{"text_run":{"content":"As different brokerage firms have varying requirements for deposits—some require fast deposits, while others require precise matching of bank statements before deposit","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":"—the system supports two deposit workflows, as shown below:","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"ASTpd9XYqoIxoPxiUFUjJaPipMg","block_type":43,"board":{"token":"ByiswEVTjhpYAabuAI2j1WaRpEd"},"parent_id":"XDCMdNeGcoQG3Dx714IjyvkdpDe"},{"block_id":"doxjp6khFxQXPhGhjisfSATAmLf","block_type":3,"heading1":{"elements":[{"text_run":{"content":"Prerequisites","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"XDCMdNeGcoQG3Dx714IjyvkdpDe"},{"block_id":"doxjpImulpMqA66v4ZDtToxI2Mh","block_type":2,"parent_id":"XDCMdNeGcoQG3Dx714IjyvkdpDe","text":{"elements":[{"text_run":{"content":"None","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"doxjporhdcSl30g8ygZrDrvGuCg","block_type":3,"heading1":{"elements":[{"text_run":{"content":"2. ","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":"Operation Instructions","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"XDCMdNeGcoQG3Dx714IjyvkdpDe"},{"block_id":"doxjpdWl93ozT05k6adMrAMrbKd","block_type":19,"callout":{"background_color":5,"border_color":5,"emoji_id":"round_pushpin","text_color":1},"children":["doxjp4XiyalD1arLUv8FzgJF7qe"],"parent_id":"XDCMdNeGcoQG3Dx714IjyvkdpDe"},{"block_id":"doxjp4XiyalD1arLUv8FzgJF7qe","block_type":2,"parent_id":"doxjpdWl93ozT05k6adMrAMrbKd","text":{"elements":[{"text_run":{"content":"Navigation: Cash Management > Deposit","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"doxjpnwpX9jgvvSvB2T7VgnBuAc","block_type":4,"heading2":{"elements":[{"text_run":{"content":"Deposit Application","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"XDCMdNeGcoQG3Dx714IjyvkdpDe"},{"block_id":"doxjpIDjnRSVThfC3N06qvej2Nb","block_type":2,"parent_id":"XDCMdNeGcoQG3Dx714IjyvkdpDe","text":{"elements":[{"text_run":{"content":"A deposit application is initiated by the client. The application usually includes four main parts: currency, application amount, recipient bank card, and remarks. Whale operators can manually assist clients with deposit submissions and may reject an application or submit it for approval based on the the information provided by clients.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"doxjphOtgNwRFNw7DLbDoJFXYxb","block_type":12,"bullet":{"elements":[{"text_run":{"content":"Create (Deposit Application)","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"XDCMdNeGcoQG3Dx714IjyvkdpDe"},{"block_id":"doxjpC6giyKYUeBrhIROCjwY7ge","block_type":2,"parent_id":"XDCMdNeGcoQG3Dx714IjyvkdpDe","text":{"elements":[{"text_run":{"content":"This function can be used when a client","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":" contacts a back-office operator to perform a manual deposit. ","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":"The operator needs to select the client, deposit currency, deposit method, and beneficiary bank, enter deposit amount and remarks, and upload supporting documents (if any).","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"DLtWdlgTdo1PRoxrZ81j4nPRpir","block_type":27,"image":{"align":2,"height":994,"scale":1,"token":"PkDobdc5YochnLxp1LFj3jJTpAc","width":2086},"parent_id":"XDCMdNeGcoQG3Dx714IjyvkdpDe"},{"block_id":"doxjpXrcdixi9gYNuXh193QXEIb","block_type":12,"bullet":{"elements":[{"text_run":{"content":"Reject: ","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":"If the deposit application submitted by a client contains an error or the back office operator deems the application invalid, the operator can click Reject.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"XDCMdNeGcoQG3Dx714IjyvkdpDe"},{"block_id":"doxjpdJQRcxA7yLE2DVARooYkHc","block_type":12,"bullet":{"elements":[{"text_run":{"content":"Delete: ","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":"If the deposit application submitted by a client contains an error or the back office operator deems the application invalid, the operator can click Delete to remove the target record.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"XDCMdNeGcoQG3Dx714IjyvkdpDe"},{"block_id":"doxjphByGYGgz8Y6QUTbXfCcphb","block_type":12,"bullet":{"elements":[{"text_run":{"content":"Edit: ","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":"If an issue is found with a client's deposit application before submission for approval, the operator can click Audit to correct it after confirming with the client. ","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":"Edits require a work-order approval; changes take effect only after approval.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"children":["doxjpJ5nuMOzcpr0KBmdXHjUYhc"],"parent_id":"XDCMdNeGcoQG3Dx714IjyvkdpDe"},{"block_id":"doxjpJ5nuMOzcpr0KBmdXHjUYhc","block_type":12,"bullet":{"elements":[{"text_run":{"content":"Editable fields: ","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":"Deposit Currency, Deposit Method, Beneficiary Bank, Deposit Amount, Deposit Fee, Remarks, and Supporting Document","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"children":["BlQxduCPpo9A9QxK88hjSTJlpzg"],"parent_id":"doxjphByGYGgz8Y6QUTbXfCcphb"},{"block_id":"BlQxduCPpo9A9QxK88hjSTJlpzg","block_type":27,"image":{"align":2,"height":994,"scale":1,"token":"D9Lvb6QTOoUjM4xW5mbjjiI1p8e","width":2086},"parent_id":"doxjpJ5nuMOzcpr0KBmdXHjUYhc"},{"block_id":"LH5wdUhu1o6hIJxOILbjmiz9po4","block_type":12,"bullet":{"elements":[{"text_run":{"content":"Submit (batch submission supported): Once the operator has completed a preliminary review and confirmed that all information is accurate, the application can be submitted to the next-stage operator for review and processing.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"XDCMdNeGcoQG3Dx714IjyvkdpDe"},{"block_id":"AeptdsjXAosMotxIC49jV5MBp9e","block_type":12,"bullet":{"elements":[{"text_run":{"content":"Direct Deposit: For brokerages with time-sensitive deposit requirements, the Direct Deposit function streamlines the funding process. Upon receiving a client's deposit application, the operator only needs to supplement the bank statement details to complete the deposit. By default, Direct Deposit requires approval. To disable the approval requirement, contact the operations and maintenance team to adjust the configuration.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"XDCMdNeGcoQG3Dx714IjyvkdpDe"},{"block_id":"doxjpq2SyilJpHQlOWpC5nnpZbg","block_type":12,"bullet":{"elements":[{"text_run":{"content":"Approval required: On the Credit directly page, verify that all information is correct, and then click Submit approval. The application will be routed to the deposit review page and processed upon approval.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"XDCMdNeGcoQG3Dx714IjyvkdpDe"},{"block_id":"doxjpNhfWQUAzZm0CWBy8SUBLWd","block_type":12,"bullet":{"elements":[{"text_run":{"content":"No approval required: On the Credit directly page, verify that all information is correct, and then click Deposit directly to complete the transaction immediately.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"XDCMdNeGcoQG3Dx714IjyvkdpDe"},{"block_id":"doxjps2TpSQf5wqLaIxFu6prFdb","block_type":2,"parent_id":"XDCMdNeGcoQG3Dx714IjyvkdpDe","text":{"elements":[{"text_run":{"content":"Approval required","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"H5JqdqMbxoJFx1xvMSPjMSi5pNe","block_type":27,"image":{"align":2,"height":1436,"scale":1,"token":"CDEfb47FBoqUJ8xuqrWjen3QpOh","width":1700},"parent_id":"XDCMdNeGcoQG3Dx714IjyvkdpDe"},{"block_id":"doxjpDSG4qNwJGl1XgyA3iWtq8e","block_type":2,"parent_id":"XDCMdNeGcoQG3Dx714IjyvkdpDe","text":{"elements":[{"text_run":{"content":"No approval required","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"EZSpd7t2qoplq7xcrlGjsSnwp5b","block_type":27,"image":{"align":2,"height":1352,"scale":1,"token":"Fyg1bAhnXojjoWxEzaZjcSvPpCe","width":1698},"parent_id":"XDCMdNeGcoQG3Dx714IjyvkdpDe"},{"block_id":"doxjpxmhUaQmMc52r1GQqvrrzvc","block_type":4,"heading2":{"elements":[{"text_run":{"content":"Deposit Match","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"XDCMdNeGcoQG3Dx714IjyvkdpDe"},{"block_id":"doxjp7UEhaD84mVTgMLarONbHdc","block_type":2,"parent_id":"XDCMdNeGcoQG3Dx714IjyvkdpDe","text":{"elements":[{"text_run":{"content":"The data on this page are derived from bank deposit statements. ","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":"If a brokerage's business rules require bank statement entries to be matched with deposit records before funding, this can be handled manually on the Deposit Match page after confirming the bank statement information is synchronized with the system. The handling methods include linking for deposit and refund to clients.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"NW3tdao0uompofxM267juuSypLe","block_type":31,"children":["S8DDdSZYHoohpOx7PoUjwXgPp1e","KN7jdsiB0otA3SxTNFljkm8mpLb","PwUydfa2IodOllxLJ3OjaQl7p9d","I5PFdPntgoRs6CxJ2OWjQQmopcd","IZnYdc9KaoYBQPxJTuhj9sTIpce","NlcgdXvzoo17vQxNfL2j46y3pme","FuCCdLayloAVBKxX6vQjkEcWpRh","JWQJdHSy2o6GCqxEvrCjktANp61"],"parent_id":"XDCMdNeGcoQG3Dx714IjyvkdpDe","table":{"cells":["S8DDdSZYHoohpOx7PoUjwXgPp1e","KN7jdsiB0otA3SxTNFljkm8mpLb","PwUydfa2IodOllxLJ3OjaQl7p9d","I5PFdPntgoRs6CxJ2OWjQQmopcd","IZnYdc9KaoYBQPxJTuhj9sTIpce","NlcgdXvzoo17vQxNfL2j46y3pme","FuCCdLayloAVBKxX6vQjkEcWpRh","JWQJdHSy2o6GCqxEvrCjktANp61"],"property":{"column_size":2,"colum