d":false}}},{"block_id":"doxjpAoEXQypa0kHlTHVaGAaDFg","block_type":12,"bullet":{"elements":[{"text_run":{"content":"After the client submits a deposit request, the system automatically receives the request information and generates a unique deposit record (including record number, client securities account, deposit currency, amount, destination address, transaction hash (TXID), request time, status, and other core information).","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"SvgPdGw94oGhPIxbNlzj2QMkpEc"},{"block_id":"doxjpCzQswyTjlhjYohkoOKL0Gf","block_type":12,"bullet":{"elements":[{"text_run":{"content":"For deposit applications with exceptions or errors, back office operators can delete them directly in the system.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"SvgPdGw94oGhPIxbNlzj2QMkpEc"},{"block_id":"KA7cdm5Pgok8QtxKaAPj4cOTpHd","block_type":27,"image":{"align":2,"height":336,"scale":1,"token":"LUNXbD0T4om70DxLiR9jAo4rplW","width":1280},"parent_id":"SvgPdGw94oGhPIxbNlzj2QMkpEc"},{"block_id":"doxjptbJl8scQ0DtF36IwcrRJre","block_type":2,"parent_id":"SvgPdGw94oGhPIxbNlzj2QMkpEc","text":{"elements":[{"text_run":{"content":"Deposit Record Query and Tracking","text_element_style":{"bold":true,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"doxjp3CEZ0hKf22Kw3BrMSEe1nd","block_type":19,"callout":{"background_color":5,"border_color":5,"emoji_id":"round_pushpin","text_color":1},"children":["doxjpeSw6t2JZu0NKMwNRFduIr0"],"parent_id":"SvgPdGw94oGhPIxbNlzj2QMkpEc"},{"block_id":"doxjpeSw6t2JZu0NKMwNRFduIr0","block_type":2,"parent_id":"doxjp3CEZ0hKf22Kw3BrMSEe1nd","text":{"elements":[{"text_run":{"content":"Navigation: WBO > VA Clearing Management > Deposit & Withdrawal > Coin Deposit Records","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"doxjpZHHktqpHyzYfFYXzfRMKhb","block_type":12,"bullet":{"elements":[{"text_run":{"content":"Multi-condition Query: ","text_element_style":{"bold":true,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":"Records can be filtered by criteria such as record ID, client ID, creation time, and status, allowing operators to quickly locate the target record.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"SvgPdGw94oGhPIxbNlzj2QMkpEc"},{"block_id":"doxjpIl6gLX3SM37Mdz056SMqif","block_type":12,"bullet":{"elements":[{"text_run":{"content":"Progress Tracking: ","text_element_style":{"bold":true,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":"The full deposit process can be monitored in real time. Operators can click a record to view its details, including address verification status and blockchain confirmation progress associated with the transaction hash.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"SvgPdGw94oGhPIxbNlzj2QMkpEc"},{"block_id":"K5gHdRslfocwaQx2c7Mj0BsYpli","block_type":27,"image":{"align":2,"height":964,"scale":1,"token":"PAYtbvktAoeU9Tx9QudjsDgSpef","width":2446},"parent_id":"SvgPdGw94oGhPIxbNlzj2QMkpEc"},{"block_id":"doxjpmytykpWDwZ0pUbZrz87w7c","block_type":2,"parent_id":"SvgPdGw94oGhPIxbNlzj2QMkpEc","text":{"elements":[{"text_run":{"content":"Cancellation of Unprocessed Deposit Records","text_element_style":{"bold":true,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"doxjpYuWaH44T05z9rnF1gm7Sch","block_type":12,"bullet":{"elements":[{"text_run":{"content":"Prerequisite","text_element_style":{"bold":true,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":": ","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":"This operation applies only to records in the Wallet Auth Pending status (i.e., deposit requests for which blockchain network confirmation has not started and assets have not been transferred out). Records in other statuses cannot be canceled.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"SvgPdGw94oGhPIxbNlzj2QMkpEc"},{"block_id":"doxjpeDKUNwO5e8dDihywB0UUXs","block_type":12,"bullet":{"elements":[{"text_run":{"content":"Operation steps:","text_element_style":{"bold":true,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":":","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"children":["doxjp594mP7Bz0PAQEZYJIIGIhg","doxjpEPRlibbKcfR9fSymfgeo6c","doxjp86KrnxncJjgrSdvlP5LpXc"],"parent_id":"SvgPdGw94oGhPIxbNlzj2QMkpEc"},{"block_id":"doxjp594mP7Bz0PAQEZYJIIGIhg","block_type":13,"ordered":{"elements":[{"text_run":{"content":"In the deposit records list, locate the target record and click Cancel.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false,"sequence":"1"}},"parent_id":"doxjpeDKUNwO5e8dDihywB0UUXs"},{"block_id":"doxjpEPRlibbKcfR9fSymfgeo6c","block_type":13,"ordered":{"elements":[{"text_run":{"content":"In the confirmation pop-up window, enter an operation note (e.g., \"Duplicate application\" or \"Incorrect address provided\") and confirm the cancellation.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":";","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false,"sequence":"auto"}},"parent_id":"doxjpeDKUNwO5e8dDihywB0UUXs"},{"block_id":"doxjp86KrnxncJjgrSdvlP5LpXc","block_type":13,"ordered":{"elements":[{"text_run":{"content":"Upon successful cancellation, the record status will be updated to Canceled. The system automatically retains a cancellation operation log (including operator, operation time, and note) for future tracing.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false,"sequence":"auto"}},"parent_id":"doxjpeDKUNwO5e8dDihywB0UUXs"},{"block_id":"HgSTdtVZMoJYmJxAjwEjS8eTpAe","block_type":27,"image":{"align":2,"height":696,"scale":1,"token":"MMKDbz6nQoboX4xMiwCjWYoJpjb","width":2480},"parent_id":"SvgPdGw94oGhPIxbNlzj2QMkpEc"},{"block_id":"doxjp4hfyzKymvRy4yMRfIlC8sb","block_type":2,"parent_id":"SvgPdGw94oGhPIxbNlzj2QMkpEc","text":{"elements":[{"text_run":{"content":"Refund After Successful Deposit","text_element_style":{"bold":true,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"doxjpFP41cACI6odEzg6tsHiwHf","block_type":12,"bullet":{"elements":[{"text_run":{"content":"Prerequisite","text_element_style":{"bold":true,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":": ","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":"This operation applies only to records in the Success status (i.e., assets have been successfully credited to the platform, and the client applies for a refund or the system requires a forced refund). Operators shall verify the client's identity and the reason for the refund.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":".","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"SvgPdGw94oGhPIxbNlzj2QMkpEc"},{"block_id":"doxjpKSz8OKemKGAdgyXLREsA7d","block_type":12,"bullet":{"elements":[{"text_run":{"content":"Operation steps:","text_element_style":{"bold":true,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":":","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"children":["doxjprWqQ4QC2P0W4sjxcr6HoKd","doxjpvSdITWcNcMCNLl4vcJtyJf","doxjpdYrbJO2FghE0gwE0a2ZgKd","doxjpjoZlQfRpzAJa5jRgVOGApd","doxjpOYNAo45ofjfyidwk04l3Tm"],"parent_id":"SvgPdGw94oGhPIxbNlzj2QMkpEc"},{"block_id":"doxjprWqQ4QC2P0W4sjxcr6HoKd","block_type":13,"ordered":{"elements":[{"text_run":{"content":"Enter the Deposit page, find the target deposit record, and click Withdraw coins.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false,"sequence":"1"}},"parent_id":"doxjpKSz8OKemKGAdgyXLREsA7d"},{"block_id":"doxjpvSdITWcNcMCNLl4vcJtyJf","block_type":13,"ordered":{"elements":[{"text_run":{"content":"Fill in Refund Information: Enter the client-specified refund address (must match the client's identity verification information), select the corresponding network (must match the deposit network), and verify the refund amount (defaults to the deposit amount; can be adjusted with a reason noted for the adjustment).","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false,"sequence":"auto"}},"parent_id":"doxjpKSz8OKemKGAdgyXLREsA7d"},{"block_id":"doxjpdYrbJO2FghE0gwE0a2ZgKd","block_type":13,"ordered":{"elements":[{"text_run":{"content":"Execute Refund Operation: Click Execute Refund. The system generates a refund transaction hash and synchronizes it to the blockchain network.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false,"sequence":"auto"}},"parent_id":"doxjpKSz8OKemKGAdgyXLREsA7d"},{"block_id":"doxjpjoZlQfRpzAJa5jRgVOGApd","block_type":13,"ordered":{"elements":[{"text_run":{"content":"Track Refund Status: Monitor the blockchain confirmation progress of the refund record in real-time. Upon completion, update the deposit record status to refund and keep the full-process log of the refund.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false,"sequence":"auto"}},"parent_id":"doxjpKSz8OKemKGAdgyXLREsA7d"},{"block_id":"doxjpOYNAo45ofjfyidwk04l3Tm","block_type":13,"ordered":{"elements":[{"text_run":{"content":"Notify Client: Upon successful refund, notify the client through offline channels.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false,"sequence":"auto"}},"parent_id":"doxjpKSz8OKemKGAdgyXLREsA7d"},{"block_id":"Rty8dwdVgooIC3xZaONjXZwEpng","block_type":27,"image":{"align":2,"height":732,"scale":1,"token":"BJjcbxXoRocUVRxxSqjjdw2upig","width":2452},"parent_id":"SvgPdGw94oGhPIxbNlzj2QMkpEc"}]}