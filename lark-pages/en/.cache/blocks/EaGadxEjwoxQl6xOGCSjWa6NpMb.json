e,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"language":67,"wrap":false}},"parent_id":"EaGadxEjwoxQl6xOGCSjWa6NpMb"},{"block_id":"doxjp8wMMg9p7zW06vgEJtD9Ede","block_type":3,"heading1":{"elements":[{"text_run":{"content":"System Introduction","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"EaGadxEjwoxQl6xOGCSjWa6NpMb"},{"block_id":"doxjptuljxHoQ7YzvPe4D0cYj7f","block_type":3,"heading1":{"elements":[{"text_run":{"content":"1. System Overview","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"EaGadxEjwoxQl6xOGCSjWa6NpMb"},{"block_id":"doxjpbzHoL8gDG3W6BE7haRKCie","block_type":2,"parent_id":"EaGadxEjwoxQl6xOGCSjWa6NpMb","text":{"elements":[{"text_run":{"content":"Securities transfer-out is a service in the financial system that allows investors to transfer their securities holdings from one account to another to achieve flexible asset allocation and management.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"doxjpEEqajbmdsufpB5SJL415Mh","block_type":2,"parent_id":"EaGadxEjwoxQl6xOGCSjWa6NpMb","text":{"elements":[{"text_run":{"content":"The Whale system includes functions such as transfer-out application, transfer-out details, and email notification to brokers. The process supports the review requirements of different roles and effectively reduces the risks during securities transfer-out. The overall process is as follows:","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"VoVzdzf8To8GAhxCCszj8sG1p9b","block_type":43,"board":{"token":"KgDUwdi7mhFjWCbA4kBjkfBSpQe"},"parent_id":"EaGadxEjwoxQl6xOGCSjWa6NpMb"},{"block_id":"doxjpxH8rTh9jbju6hmMJFwLGeh","block_type":4,"heading2":{"elements":[{"text_run":{"content":"Prerequisite","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"EaGadxEjwoxQl6xOGCSjWa6NpMb"},{"block_id":"doxjpe4hvBfsqS3XgfmTmBT0eof","block_type":2,"parent_id":"EaGadxEjwoxQl6xOGCSjWa6NpMb","text":{"elements":[{"text_run":{"content":"None","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"doxjpVmcRzno9a0ruN79siXsKRg","block_type":3,"heading1":{"elements":[{"text_run":{"content":"2.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":"Operation Instructions","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"EaGadxEjwoxQl6xOGCSjWa6NpMb"},{"block_id":"doxjpNiwubgu4zkVHDDctfkKZcc","block_type":19,"callout":{"background_color":5,"border_color":5,"emoji_id":"round_pushpin","text_color":1},"children":["doxjpnE6VTrIx5t9mFQYNPf1fIg"],"parent_id":"EaGadxEjwoxQl6xOGCSjWa6NpMb"},{"block_id":"doxjpnE6VTrIx5t9mFQYNPf1fIg","block_type":2,"parent_id":"doxjpNiwubgu4zkVHDDctfkKZcc","text":{"elements":[{"text_run":{"content":"Navigation: Stock Management > Transfer Out","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"doxjpDOIPamHxSF1qnZH18e9Bvg","block_type":4,"heading2":{"elements":[{"text_run":{"content":"Transfer-Out Application","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"EaGadxEjwoxQl6xOGCSjWa6NpMb"},{"block_id":"doxjpIFTKQMp0dSpKF5h6oLMm2e","block_type":2,"parent_id":"EaGadxEjwoxQl6xOGCSjWa6NpMb","text":{"elements":[{"text_run":{"content":"A transfer-in application is initiated by the client and consists of four components: broker information, account information, securities details, and remarks. Back office operators can create applications manually on a client's behalf, and may take the following actions on any submitted application: reject, submit for approval, or notify the delivering broker.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"doxjpfBIqujT4CLJVnguX3bqi7N","block_type":12,"bullet":{"elements":[{"text_run":{"content":"Manual transfer-out: This applies when a client contacts a back office operator to request a manual transfer-out. The operator must enter the client's security details and account information.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"children":["doxjpwa89yNSEPG6n9L5y5XXamh"],"parent_id":"EaGadxEjwoxQl6xOGCSjWa6NpMb"},{"block_id":"doxjpwa89yNSEPG6n9L5y5XXamh","block_type":12,"bullet":{"elements":[{"text_run":{"content":"After the operator selects a client, the system automatically populates all of the client's holdings. Then the operator selects the target records, checks the quantities to be transferred out, and confirms the transfer-out.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"doxjpfBIqujT4CLJVnguX3bqi7N"},{"block_id":"WbcBdg0ZxoKUQVxZrBLjm4gwpVi","block_type":27,"image":{"align":2,"height":1312,"scale":1,"token":"O7q0b0PINoFRusxRjs3jNt4vpHf","width":2994},"parent_id":"EaGadxEjwoxQl6xOGCSjWa6NpMb"},{"block_id":"doxjpAySVeyRR6EehzmlrHm6HQd","block_type":12,"bullet":{"elements":[{"text_run":{"content":"Reject (batch operation supported): If the transfer-out application submitted by a client contains an error or the back office operator deems the application invalid, the operator can click Reject.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"EaGadxEjwoxQl6xOGCSjWa6NpMb"},{"block_id":"doxjpK4UhzdqdYAQ8UYDwgjYhQf","block_type":12,"bullet":{"elements":[{"text_run":{"content":"Notify Broker: Since transfer-out operations require cooperation from the delivering broker, in practice, operators need to contact the delivering broker to ensure a timely transfer-out. The Notify Broker function provides an in-system email tool that allows operators to send notifications to the delivering broker. Email delivery results are displayed to operators, giving them visibility into whether the broker has been notified.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"children":["doxjpCKIlqvAsacPtP91wCtZxNh","doxjp3n2NLOwm6SEPs7qQBywPlc","doxjpFjmr9tlyqyyKcNcXNGPi4b","doxjpcUIKDGi3jk5ov9p9P8UJFc"],"parent_id":"EaGadxEjwoxQl6xOGCSjWa6NpMb"},{"block_id":"doxjpCKIlqvAsacPtP91wCtZxNh","block_type":12,"bullet":{"elements":[{"text_run":{"content":"Select the broker institution to which the email should be sent. The system will automatically populate the broker's email address. The operator should verify that the email address is correct.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"doxjpK4UhzdqdYAQ8UYDwgjYhQf"},{"block_id":"doxjp3n2NLOwm6SEPs7qQBywPlc","block_type":12,"bullet":{"elements":[{"text_run":{"content":"Select the securities transfer-out application details under the target broker. (Already-sent application details will be excluded.)","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"doxjpK4UhzdqdYAQ8UYDwgjYhQf"},{"block_id":"doxjpFjmr9tlyqyyKcNcXNGPi4b","block_type":12,"bullet":{"elements":[{"text_run":{"content":"Preview the email content, and click OK after confirming it is correct.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"doxjpK4UhzdqdYAQ8UYDwgjYhQf"},{"block_id":"doxjpcUIKDGi3jk5ov9p9P8UJFc","block_type":12,"bullet":{"elements":[{"text_run":{"content":"Go to the Email Records tab to check the sending status.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"doxjpK4UhzdqdYAQ8UYDwgjYhQf"},{"block_id":"OotJdtGnRo37i8x4PfJj4zfEpWf","block_type":27,"image":{"align":2,"height":572,"scale":1,"token":"ZeI7bupM6ouP1wxXi6fjYnYUpOe","width":1280},"parent_id":"EaGadxEjwoxQl6xOGCSjWa6NpMb"},{"block_id":"Qlkadp3uRoe6XYxh9wjjyAQzpGe","block_type":27,"image":{"align":2,"height":567,"scale":1,"token":"Pz6sbSR74oT1WZx6QFGj5AEvpWe","width":1280},"parent_id":"EaGadxEjwoxQl6xOGCSjWa6NpMb"},{"block_id":"XLc4dD7rEoDj5WxqXewjpTzppAe","block_type":27,"image":{"align":2,"height":1312,"scale":1,"token":"UvkbbEp9eoGlx2xo4BsjD8WGpoe","width":2996},"parent_id":"EaGadxEjwoxQl6xOGCSjWa6NpMb"},{"block_id":"KebMdRpxLopfflxVP32jwWbbpLf","block_type":27,"image":{"align":2,"height":1320,"scale":1,"token":"QCKzbL88FopUWTxxQCZjAlYKppd","width":2976},"parent_id":"EaGadxEjwoxQl6xOGCSjWa6NpMb"},{"block_id":"doxjpo5wUhTCITg9yKo2zwsKFLh","block_type":12,"bullet":{"elements":[{"text_run":{"content":"Submit (batch operation supported): Once the operator has completed a preliminary review and confirmed that the application contains no issues, click Submit to forward the application to the next-stage operator for further review and processing.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"EaGadxEjwoxQl6xOGCSjWa6NpMb"},{"block_id":"doxjpP6vLuXt7N9wfPrcriYieA8","block_type":12,"bullet":{"elements":[{"text_run":{"content":"Edit: If, while processing a transfer-out application, the operator receives updated information from the client regarding whether the delivering broker has been notified, click Edit to update the notification status accordingly. This ensures that the application record reflects the actual state of broker notification.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"EaGadxEjwoxQl6xOGCSjWa6NpMb"},{"block_id":"JYU4dm31GosIbvx1Ap0jDm1npQc","block_type":27,"image":{"align":2,"height":1317,"scale":1,"token":"BZCMb3S8qozffhxxoyajEb94pXf","width":2984},"parent_id":"EaGadxEjwoxQl6xOGCSjWa6NpMb"},{"block_id":"doxjpeqAmlwjxdj6crbwunKk7ug","block_type":12,"bullet":{"elements":[{"text_run":{"content":"Indicator Cards","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"EaGadxEjwoxQl6xOGCSjWa6NpMb"},{"block_id":"doxjpfSdBPUEmIYMFbGmUbnQPZe","block_type":2,"parent_id":"EaGadxEjwoxQl6xOGCSjWa6NpMb","text":{"elements":[{"text_run":{"content":"For brokers with high transfer-out volumes, the system provides categorized indicator cards for refined operations. The cards are arranged from left to right in alignment with the sequence of business operations. The available batch operations include:","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"IwzLdbYg3ohtVaxcqVXj2xUrpCb","block_type":27,"image":{"align":2,"height":1320,"scale":1,"token":"RG8BbdWmho83DnxV6X5jFUoopJh","width":2954},"parent_id":"EaGadxEjwoxQl6xOGCSjWa6NpMb"},{"block_id":"doxjpD0V9Q2uJcAyLkdMLfsxnwe","block_type":4,"heading2":{"elements":[{"text_run":{"content":"Transfer-Out Details","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"EaGadxEjwoxQl6xOGCSjWa6NpMb"},{"block_id":"doxjpcNoajUMRerSkMYPD5fGaKd","block_type":2,"parent_id":"EaGadxEjwoxQl6xOGCSjWa6NpMb","text":{"elements":[{"text_run":{"content":"As a transfer-out application may contain multiple securities detail records, the operator responsible for processing the transfer-out must carefully review each record before the transfer-out can proceed.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"doxjphoHCp3b8GSMQKMnpSzHNye","block_type":12,"bullet":{"elements":[{"text_run":{"content":"Edit: If the operator finds an issue with a specific detailed record submitted by the client when processing securities details, the operator can click Edit to correct the record after confirming with the client.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"children":["QFFFdXHdNo2b9XxLT0NjuLEQpUd","doxjpZRfdLMxiXOh83EGE0HOrle"],"parent_id":"EaGadxEjwoxQl6xOGCSjWa6NpMb"},{"block_id":"QFFFdXHdNo2b9XxLT0NjuLEQpUd","block_type":27,"image":{"align":2,"height":1308,"scale":1,"token":"OMqvb8doloaJJFxwa23j5AGWpdb","width":2958},"parent_id":"doxjphoHCp3b8GSMQKMnpSzHNye"},{"block_id":"doxjpZRfdLMxiXOh83EGE0HOrle","block_type":12,"bullet":{"elements":[{"text_run":{"content":"Editable fields include the custodian code, sub-account number, securities detail quantity, and remarks.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"doxjphoHCp3b8GSMQKMnpSzHNye"},{"block_id":"doxjpk8fjUUaClk9ihdpw9dIzLb","block_type":12,"bullet":{"elements":[{"text_run":{"content":"Modify Transfer Fees: Before transfer-out, the operator can choose whether to adjust the client's transfer fees and whether the modified information should be displayed to the client based on the actual business scenario.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"EaGadxEjwoxQl6xOGCSjWa6NpMb"},{"block_id":"UjSPdlPuFooYe7xrHChjXw7gpHc","block_type":27,"image":{"align":2,"height":1324,"scale":1,"token":"MbD1bVnysoPJAsxAGvtjua5gpWQ","width":2988},"parent_id":"EaGadxEjwoxQl6xOGCSjWa6NpMb"},{"block_id":"NtSTdhduAo6SEIxbXkdjZkXFpYI","block_type":27,"image":{"align":2,"height":1379,"scale":1,"token":"AUQSbDFwoo2Ro1x9g9vjTcGHpde","width":2970},"parent_id":"EaGadxEjwoxQl6xOGCSjWa6NpMb"},{"block_id":"doxjpq4lf6UrNHenZlzkRvoiVmb","block_type":12,"bullet":{"elements":[{"text_run":{"content":"Delete: If the client reports that a specific submitted detail record should no longer be included in the transfer-out, the operator can click Delete to delete the target record.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"EaGadxEjwoxQl6xOGCSjWa6NpMb"},{"block_id":"doxjpnuhmZ9zrqUeMmP0PZ8NaIb","block_type":12,"bullet":{"elements":[{"text_run":{"content":"Generate SI: Since securities transfer-out requires SI information to be entered into CCASS, operators can click Generate SI to have the system automatically compile and save the SI data as an uploadable file, eliminating the need for manual entry in CCASS. Generated SI files can be viewed and exported from the SI List section.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"EaGadxEjwoxQl6xOGCSjWa6NpMb"},{"block_id":"Ehtgdb8Ujo4bCbxtGTrjUIDXpsb","block_type":27,"image":{"align":2,"height":1479,"scale":1,"token":"EY2Bb19nUonq4VxLdSgjOqGKpvh","width":2978},"parent_id":"EaGadxEjwoxQl6xOGCSjWa6NpMb"},{"block_id":"NEO5dRX64o60uVxOYIdjzighpcd","block_type":27,"image":{"align":2,"height":1310,"scale":1,"token":"McMYbW4cEorUTfxqDT4j94gLpQf","width":2998},"parent_id":"EaGadxEjwoxQl6xOGCSjWa6NpMb"},{"block_id":"doxjpRXSNakGkgvy0gWmSXgSJbb","block_type":12,"bullet":{"elements":[{"text_run":{"content":"Edit SI: The operator can click Edit SI to modify the generated SI file.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"EaGadxEjwoxQl6xOGCSjWa6NpMb"},{"block_id":"DQ7hdaJQRolEZRxkwzpjtCDopWb","block_type":27,"image":{"align":2,"height":1509,"scale":1,"token":"Ai38bHSWgo0bOQx8yBijKA2rpy3","width":2990},"parent_id":"EaGadxEjwoxQl6xOGCSjWa6NpMb"},{"block_id":"doxjpdRZlvEmKILdxtiwrB5Wqvf","block_type":12,"bullet":{"elements":[{"text_run":{"content":"Handle-Submit as Successful/Submit as Failed: Once the operator has verified that a detail record contains no issues, click Handle and select Submit as Successful. If issues are identified, select Submit as Failed.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"children":["XJhPdpNmpohXe9xEyo1jO5vIpnb","doxjpLsVE9EAbfs980GFrWaEqtf"],"parent_id":"EaGadxEjwoxQl6xOGCSjWa6NpMb"},{"block_id":"XJhPdpNmpohXe9xEyo1jO5vIpnb","block_type":27,"image":{"align":2,"height":1323,"scale":1,"token":"Qg0FbfThkoqM9TxwizbjItQKppe","width":2962},"parent_id":"doxjpdRZlvEmKILdxtiwrB5Wqvf"},{"block_id":"doxjpLsVE9EAbfs980GFrWaEqtf","block_type":12,"bullet":{"elements":[{"text_run":{"content":"After pro