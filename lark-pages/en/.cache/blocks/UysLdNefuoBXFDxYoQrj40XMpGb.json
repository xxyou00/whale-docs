 transferring cryptocurrency (such as Bitcoin, Ethereum, etc.) from one address (for example, another trading platform or another person's wallet) to one's own digital wallet or trading platform account. This process relies on blockchain technology to ensure the secure transfer of assets, and requires wallet address verification to ensure operational compliance and fund security.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"doxjpEI0A2ibbYgHpzLL6WASZLC","block_type":3,"heading1":{"elements":[{"text_run":{"content":"Deposit Steps","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"UysLdNefuoBXFDxYoQrj40XMpGb"},{"block_id":"doxjpt9QcwswQop2FtLqovP3iXd","block_type":13,"ordered":{"elements":[{"text_run":{"content":"Go to the target platform/wallet and enter the Top-up or Deposit page.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false,"sequence":"auto"}},"parent_id":"UysLdNefuoBXFDxYoQrj40XMpGb"},{"block_id":"doxjpEs9NCbqCSPM6QVDb7wFVCe","block_type":13,"ordered":{"elements":[{"text_run":{"content":"Select the corresponding currency and network (must be consistent with that of the sending platform/wallet).","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false,"sequence":"auto"}},"parent_id":"UysLdNefuoBXFDxYoQrj40XMpGb"},{"block_id":"doxjpvdHXhaVchN4lNRyPGfdMmh","block_type":13,"ordered":{"elements":[{"text_run":{"content":"Copy the generated deposit address (verify that it is correct).","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false,"sequence":"auto"}},"parent_id":"UysLdNefuoBXFDxYoQrj40XMpGb"},{"block_id":"doxjpIfe3w76cWwvAPJHZaCoDoc","block_type":13,"ordered":{"elements":[{"text_run":{"content":"Log in to the sending platform/wallet, paste the address, enter the amount, and submit after completing security verification.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false,"sequence":"auto"}},"parent_id":"UysLdNefuoBXFDxYoQrj40XMpGb"},{"block_id":"doxjp6zotd541VhnoVE9jvnwhbc","block_type":13,"ordered":{"elements":[{"text_run":{"content":"Wait for blockchain confirmations and check the receipt status on the target platform/wallet.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false,"sequence":"auto"}},"parent_id":"UysLdNefuoBXFDxYoQrj40XMpGb"},{"block_id":"doxjpiFwb0L7m3pm1jDQ1TY40Ud","block_type":19,"callout":{"background_color":5,"border_color":5,"emoji_id":"round_pushpin","text_color":1},"children":["doxjpvPXBYLaSllFkH4Jb7oa8la"],"parent_id":"UysLdNefuoBXFDxYoQrj40XMpGb"},{"block_id":"doxjpvPXBYLaSllFkH4Jb7oa8la","block_type":2,"parent_id":"doxjpiFwb0L7m3pm1jDQ1TY40Ud","text":{"elements":[{"text_run":{"content":"Note: ","text_element_style":{"bold":true,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":"Virtual currency accounts are recorded as combined assets of \"cryptocurrency + quotation currency\". Deposits and withdrawals are recorded separately by cryptocurrency. When ultimately synchronized to the securities account, they are recorded under the combined asset (Example: ETH with a default quotation currency of USD would be recorded under the symbol VA/HAS/ETHUSD). During a withdrawal, the system will first deduct from the cryptocurrency with the largest available balance. If that balance is insufficient to cover the withdrawal amount, the system will automatically draw from the cryptocurrency with the second-largest balance.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}}]}