oxjpG5u15sbvTRDHDWRpV4crcb","block_type":3,"heading1":{"elements":[{"text_run":{"content":"Overview","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"YN3XdfM7VoRQEoxmBdGj3lLppEc"},{"block_id":"doxjpWBgR5FO39RrBqHgwzTBsIg","block_type":2,"parent_id":"YN3XdfM7VoRQEoxmBdGj3lLppEc","text":{"elements":[{"text_run":{"content":"Cryptocurrency withdrawal refers to the process of transferring cryptocurrency (such as BTC, ETH, USDT, etc.) from a personal digital wallet or trading platform account to another address (including other wallets or other trading platform accounts). If conversion to fiat currency is required, the client must first complete a sell transaction on a trading platform before withdrawing the corresponding fiat amount to a bank account. This guide focuses on the direct cryptocurrency transfer scenario.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"doxjpmbuIMf6hCtxjWb65gmxEyg","block_type":2,"parent_id":"YN3XdfM7VoRQEoxmBdGj3lLppEc","text":{"elements":[{"text_run":{"content":"Operation process: ","text_element_style":{"bold":true,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":"The client initiates a withdrawal through the app by entering the recipient address and transfer amount. Once the request has passed platform review (including WBO work order approval) and received the required number of blockchain confirmations, the asset transfer is complete.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"doxjpjRW6L47MGyij4LqJXuV4Qw","block_type":3,"heading1":{"elements":[{"text_run":{"content":"Quick Start","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"YN3XdfM7VoRQEoxmBdGj3lLppEc"},{"block_id":"doxjpvfa8wsUDKxpG3f1R3hHRJd","block_type":4,"heading2":{"elements":[{"text_run":{"content":"Prerequisite","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"YN3XdfM7VoRQEoxmBdGj3lLppEc"},{"block_id":"doxjpb9JwXB2eKDwqJWLk43YYag","block_type":2,"parent_id":"YN3XdfM7VoRQEoxmBdGj3lLppEc","text":{"elements":[{"text_run":{"content":"Operators must obtain the following permissions before they can use the system functions properly.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"doxjpU3p2rzOHlMYeL1uS8D15Ig","block_type":30,"parent_id":"YN3XdfM7VoRQEoxmBdGj3lLppEc","sheet":{"token":"VIZIsQXBzhGV3VtxIY2jeWfLpXe_USZ9N1"}},{"block_id":"doxjpnxzvrgUKR2Tjfq6bnuKs0b","block_type":4,"heading2":{"elements":[{"text_run":{"content":"Cryptocurrency Service Fee Reserve on HashKey","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"YN3XdfM7VoRQEoxmBdGj3lLppEc"},{"block_id":"doxjpjBm88AhlNvuPh8d3FHIDfb","block_type":2,"parent_id":"YN3XdfM7VoRQEoxmBdGj3lLppEc","text":{"elements":[{"text_run":{"content":"When initiating a cryptocurrency withdrawal operation on the HashKey platform, operators must be aware of the service fee deduction rules and account fund reserve requirements, as detailed below:","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"doxjpsCaYHNuxOD3ILdCuMuDgAe","block_type":13,"ordered":{"elements":[{"text_run":{"content":"Service fee deduction accounts","text_element_style":{"bold":true,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false,"sequence":"auto"}},"parent_id":"YN3XdfM7VoRQEoxmBdGj3lLppEc"},{"block_id":"doxjpPk9cw2wanJLJcl5Uhd2bBf","block_type":2,"parent_id":"YN3XdfM7VoRQEoxmBdGj3lLppEc","text":{"elements":[{"text_run":{"content":"The blockchain network service fee (e.g., miner fee) incurred during a cryptocurrency withdrawal is deducted from the main account, while the withdrawal principal is deducted from the tenant's sub-account. These two deductions are independent of each other. If the sub-account holds sufficient principal but the main account has no available balance to cover the service fee, the withdrawal will fail.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"doxjp5vDx29fMDxk9iZWwDT75bb","block_type":13,"ordered":{"elements":[{"text_run":{"content":"Main account fund reserve requirements","text_element_style":{"bold":true,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false,"sequence":"auto"}},"parent_id":"YN3XdfM7VoRQEoxmBdGj3lLppEc"},{"block_id":"doxjpNgRQQNT7YiaOq89Bz1mtZf","block_type":2,"parent_id":"YN3XdfM7VoRQEoxmBdGj3lLppEc","text":{"elements":[{"text_run":{"content":"To ensure that withdrawals are processed successfully, the tenant must maintain a reserve of the relevant cryptocurrency in the main account before initiating a withdrawal (for example, a small amount of BTC for a BTC withdrawal, or USDT for a USDT withdrawal). The reserve must be sufficient to cover the estimated service fee for the transaction, which can be viewed on the withdrawal page in real time.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"doxjpBCYVTCOyEDKbFIVcfjk4He","block_type":13,"ordered":{"elements":[{"text_run":{"content":"Common issues","text_element_style":{"bold":true,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false,"sequence":"auto"}},"parent_id":"YN3XdfM7VoRQEoxmBdGj3lLppEc"},{"block_id":"doxjpYqOGvS93ncDSEoourKrMaf","block_type":2,"parent_id":"YN3XdfM7VoRQEoxmBdGj3lLppEc","text":{"elements":[{"text_run":{"content":"If a \"Main account service fee insufficient\" error appears during a withdrawal, the client should either deposit the relevant cryptocurrency into the main account, or transfer a small amount from the sub-account to the main account as a service fee reserve. The withdrawal application can then be resubmitted.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"RZXKdo6YyowcNrxrjsCjtoSrpxb","block_type":43,"board":{"token":"TyC0wfeVwhvjqMbX1YojKi5Vpoe"},"parent_id":"YN3XdfM7VoRQEoxmBdGj3lLppEc"},{"block_id":"doxjpBYMBMlwV2mO9WspY247dse","block_type":4,"heading2":{"elements":[{"text_run":{"content":"Cryptocurrency Configuration","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"YN3XdfM7VoRQEoxmBdGj3lLppEc"},{"block_id":"doxjpSYZE2FnFNJGMI94z88kddg","block_type":2,"parent_id":"YN3XdfM7VoRQEoxmBdGj3lLppEc","text":{"elements":[{"text_run":{"content":"Operators should configure cryptocurrency settings for withdrawals before processing client withdrawals.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"Vv6IdBKwWoodqUxQlR2jcPJYp1c","block_type":27,"image":{"align":2,"height":1188,"scale":1,"token":"XCWZbBM2ioDNPTxN9DVjQSXLpQh","width":2474},"parent_id":"YN3XdfM7VoRQEoxmBdGj3lLppEc"},{"block_id":"doxjp5pC5ACCsh6Hop3k4eJR3Ke","block_type":3,"heading1":{"elements":[{"text_run":{"content":"Client Wallet Address","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"YN3XdfM7VoRQEoxmBdGj3lLppEc"},{"block_id":"doxjptfSfr70YFUYCNBIkNnNhLf","block_type":2,"parent_id":"YN3XdfM7VoRQEoxmBdGj3lLppEc","text":{"elements":[{"text_run":{"content":"To ensure asset security, wallet address verification must be completed before a withdrawal is processed. This is a critical prerequisite step.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"IQzgdg65Doow7fxYXTIjlp1bpFe","block_type":27,"image":{"align":2,"height":1164,"scale":1,"token":"MsepbKsJKo7Dsjx9Fhbjvs0dpLr","width":2440},"parent_id":"YN3XdfM7VoRQEoxmBdGj3lLppEc"},{"block_id":"doxjp6SUN9scr1TZj1lJjVNcXtd","block_type":4,"heading2":{"elements":[{"text_run":{"content":"Processing Withdrawal Applications","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"YN3XdfM7VoRQEoxmBdGj3lLppEc"},{"block_id":"doxjpmmXSRfLOgURmCq1RSsNKbJ","block_type":2,"parent_id":"YN3XdfM7VoRQEoxmBdGj3lLppEc","text":{"elements":[{"text_run":{"content":"If the client has submitted a withdrawal application in the app, the record will be automatically displayed on this page.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"doxjpmf6oVssr6qOm7aUDqJEZsh","block_type":2,"parent_id":"YN3XdfM7VoRQEoxmBdGj3lLppEc","text":{"elements":[{"text_run":{"content":"Withdrawal applications submitted by clients are automatically linked to the WBO work order system (work order ID: atm.va.coin_withdraw_apply). The system will conduct the approval process based on the pre-configured approval workflow.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"K3DodjP6sohNCIx1VCsj7CFSpHb","block_type":27,"image":{"align":2,"height":602,"scale":1,"token":"NmyObhgk1ohCjPx8oH5jCTlUpcb","width":2468},"parent_id":"YN3XdfM7VoRQEoxmBdGj3lLppEc"}]}