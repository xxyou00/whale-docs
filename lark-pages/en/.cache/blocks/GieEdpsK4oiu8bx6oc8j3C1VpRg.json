ck_type":3,"heading1":{"elements":[{"text_run":{"content":"Withdrawal Steps","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"GieEdpsK4oiu8bx6oc8j3C1VpRg"},{"block_id":"doxjpEnQcblb8RR9rMrzJtUPK82","block_type":2,"parent_id":"GieEdpsK4oiu8bx6oc8j3C1VpRg","text":{"elements":[{"text_run":{"content":"The basic process for ","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":"withdrawal","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":" is as follows:","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"doxjpn9G4c2W3YjHte4d95wwnw0","block_type":2,"parent_id":"GieEdpsK4oiu8bx6oc8j3C1VpRg","text":{"elements":[{"text_run":{"content":"Client Withdrawal Request","text_element_style":{"bold":true,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":": The client submits a withdrawal request to the securities company. This can be done through various channels, such as an online platform, by telephone, or by completing a request form at the ","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":"company's","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":" counter.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"doxjp8kX3enT6BJwXI6037yvmxh","block_type":2,"parent_id":"GieEdpsK4oiu8bx6oc8j3C1VpRg","text":{"elements":[{"text_run":{"content":"Identity Verification","text_element_style":{"bold":true,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":": ","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":"The securities company verifies the client's identity. This typically requires the client to provide identification documents or other relevant identity verification information.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"doxjpJN83oZpAH2N7qu6lVj4Oxg","block_type":2,"parent_id":"GieEdpsK4oiu8bx6oc8j3C1VpRg","text":{"elements":[{"text_run":{"content":"Source of Funds Confirmation","text_element_style":{"bold":true,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":": ","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":"The securities company verifies that the funds are legitimate and compliant by requiring clients to provide proof of the funds' source.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"doxjp3OqQrps5sk2T879y0GnUrf","block_type":2,"parent_id":"GieEdpsK4oiu8bx6oc8j3C1VpRg","text":{"elements":[{"text_run":{"content":"Application Processing","text_element_style":{"bold":true,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":": After receiving the ","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":"client's","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":" withdrawal request, the securities company performs internal review and processing. They will verify ","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":"the available funds in the client's account and the withdrawal amount to ensure compliance with requirements","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":".","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"doxjptRnBxo34df4Bp3VRPTzbig","block_type":2,"parent_id":"GieEdpsK4oiu8bx6oc8j3C1VpRg","text":{"elements":[{"text_run":{"content":"Fund Transfer","text_element_style":{"bold":true,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":": The securities company transfers the client-specified funds to the designated account. This may involve fund transfer operations with banks or other financial institutions.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"doxjpenNaJwrCnzOL7KfKm0uNuf","block_type":2,"parent_id":"GieEdpsK4oiu8bx6oc8j3C1VpRg","text":{"elements":[{"text_run":{"content":"Confirmation Notice","text_element_style":{"bold":true,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":": ","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":"Once the fund transfer is complete, the securities company sends a confirmation notice to the client, informing them that the withdrawal has been completed.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"doxjpk0uVHsehwjBJcEWrY4rSeh","block_type":2,"parent_id":"GieEdpsK4oiu8bx6oc8j3C1VpRg","text":{"elements":[{"text_run":{"content":"Settlement","text_element_style":{"bold":true,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":": The securities company carries out internal accounting settlement to ensure the accuracy of the withdrawal operation.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"doxjpn5R1sslE32LVeY8GAUrADe","block_type":2,"parent_id":"GieEdpsK4oiu8bx6oc8j3C1VpRg","text":{"elements":[{"text_run":{"content":"Records and ","text_element_style":{"bold":true,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":"Report","text_element_style":{"bold":true,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":": ","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":"The securities company records the withdrawal operation in the client's account and generates relevant reports. These records and reports facilitate the supervision and audit of the compliance of withdrawal operations.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}}]}