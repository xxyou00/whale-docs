e_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":"sidebar_position: 2","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"language":67,"wrap":false}},"parent_id":"K3qdd1XEoor1t9xRePkjJNI8pah"},{"block_id":"doxjpqG2cEiWWAf7uX6rzkD2ALh","block_type":3,"heading1":{"elements":[{"text_run":{"content":"System Introduction","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"K3qdd1XEoor1t9xRePkjJNI8pah"},{"block_id":"doxjpB8sUduoYDRJG6GndepzsFc","block_type":4,"heading2":{"elements":[{"text_run":{"content":"I. System Overview","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"K3qdd1XEoor1t9xRePkjJNI8pah"},{"block_id":"KU66dOYVVoMoRHxnEP3juT2ppaf","block_type":2,"parent_id":"K3qdd1XEoor1t9xRePkjJNI8pah","text":{"elements":[{"text_run":{"content":"The securities transfer-in feature enables investors to transfer securities holdings into their securities accounts through the securities trading platform. This feature allows investors to efficiently transfer securities, enabling them to participate in securities trading and investment activities anytime, anywhere.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"RYind2Xl2oida0xPsvxj7AZQp3c","block_type":2,"parent_id":"K3qdd1XEoor1t9xRePkjJNI8pah","text":{"elements":[{"text_run":{"content":"The Whale system includes functions such as transfer-in application, transfer-in details, streamlined import parameter settings, and email notification to brokers. The process supports the review requirements of different roles and effectively improves the accuracy of securities transfer-in. The overall process is as follows:","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"Qxzjd7fImoowYIxaSaBjhubgpIb","block_type":43,"board":{"token":"QeAbwYwJqhgu5gbphrFjIHg2p7e"},"parent_id":"K3qdd1XEoor1t9xRePkjJNI8pah"},{"block_id":"doxjpvabzUR9xiJU0nqdrAqAyR3","block_type":4,"heading2":{"elements":[{"text_run":{"content":"II. ","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":"Operation Instructions","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"K3qdd1XEoor1t9xRePkjJNI8pah"},{"block_id":"doxjpe8vHCJb2VwRWbA3fvE93Pg","block_type":19,"callout":{"background_color":5,"border_color":5,"emoji_id":"round_pushpin","text_color":1},"children":["REFUdzWl4oYskIx0DSijkw1NpUe"],"parent_id":"K3qdd1XEoor1t9xRePkjJNI8pah"},{"block_id":"REFUdzWl4oYskIx0DSijkw1NpUe","block_type":2,"parent_id":"doxjpe8vHCJb2VwRWbA3fvE93Pg","text":{"elements":[{"text_run":{"content":"Navigation: Stock Management > Transfer In","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"doxjpRZKEPlwu71wiaeFh0Fhrgg","block_type":5,"heading3":{"elements":[{"text_run":{"content":"Transfer-In Application","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"K3qdd1XEoor1t9xRePkjJNI8pah"},{"block_id":"PLXidlHOio5NyWxmV3ojnB7zpPb","block_type":2,"parent_id":"K3qdd1XEoor1t9xRePkjJNI8pah","text":{"elements":[{"text_run":{"content":"A transfer-in application is initiated by the client and consists of four components: broker information, account information, securities details, and remarks. Back office operators can create applications manually on a client's behalf, and may take the following actions on any submitted application: reject, submit for approval, or notify the delivering broker.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"doxjpuIu6yrJApnYKqYovO4SsYe","block_type":12,"bullet":{"elements":[{"text_run":{"content":"Manual Transfer-in","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"K3qdd1XEoor1t9xRePkjJNI8pah"},{"block_id":"doxjpohDXghpQ1R4RPZgkrodCWe","block_type":2,"parent_id":"K3qdd1XEoor1t9xRePkjJNI8pah","text":{"elements":[{"text_run":{"content":"This applies when a client contacts a back office operator to request a manual transfer-in. The operator must enter the client's security details and account information.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"HzFVdOpIWotLbjxQJVpjcdt0p4c","block_type":27,"image":{"align":2,"height":570,"scale":1,"token":"OLmjbiLzroUchex3D9Djx3jTpSh","width":1280},"parent_id":"K3qdd1XEoor1t9xRePkjJNI8pah"},{"block_id":"CCEtdjXD6otNudx0fcDjTAnYpZe","block_type":2,"parent_id":"K3qdd1XEoor1t9xRePkjJNI8pah","text":{"elements":[{"text_run":{"content":"","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"doxjpJ5MBTBc09X7QVvPUa91Ldv","block_type":12,"bullet":{"elements":[{"text_run":{"content":"If the shares to be transferred in are physical stock, select Yes for Whether it is a physical stock.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":".","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"K3qdd1XEoor1t9xRePkjJNI8pah"},{"block_id":"doxjpTdKU2NCQ2Lmj2kjtZyYTBe","block_type":12,"bullet":{"elements":[{"text_run":{"content":"Reject (batch operation supported): If the transfer-in application submitted by a client contains an error or the back office operator deems the application invalid, the operator can click Reject.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"K3qdd1XEoor1t9xRePkjJNI8pah"},{"block_id":"doxjplT2cu4dCrNjxgLXjRQ5fBd","block_type":12,"bullet":{"elements":[{"text_run":{"content":"Notify Broker: Since transfer-in operations require cooperation from the delivering broker, in practice, operators need to contact the delivering broker to ensure a timely transfer-in. The Notify Broker function provides an in-system email tool that allows operators to send notifications to the delivering broker. Email delivery results are displayed to operators, giving them visibility into whether the broker has been notified.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"children":["doxjp4Yn4BC0vjeaLFco0g1vSml","doxjpLsqhvuAVBOvcujb4uQ7rLc","doxjpb1iAXxeet7ssaZAS3EcZRd","doxjpip5VFt4It6wl7JqW342PEb","F5jwdC8CKoislyxoFonjACZHprh","OdrTdAp3qoZ9OExnhRajiJk1prS","HDVtd2bqmoivqVx1rWcjj1ecpfb","K3rfd68jXojgwixKQEmju9pvppc"],"parent_id":"K3qdd1XEoor1t9xRePkjJNI8pah"},{"block_id":"doxjp4Yn4BC0vjeaLFco0g1vSml","block_type":12,"bullet":{"elements":[{"text_run":{"content":"Select the broker institution to which the email should be sent. The system will automatically populate the broker's email address. The operator should verify that the email address is correct.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"doxjplT2cu4dCrNjxgLXjRQ5fBd"},{"block_id":"doxjpLsqhvuAVBOvcujb4uQ7rLc","block_type":12,"bullet":{"elements":[{"text_run":{"content":"Select the securities transfer-in application details under the target broker. (Already-sent application details will be excluded.)","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"doxjplT2cu4dCrNjxgLXjRQ5fBd"},{"block_id":"doxjpb1iAXxeet7ssaZAS3EcZRd","block_type":12,"bullet":{"elements":[{"text_run":{"content":"Preview the email content, and click OK after confirming it is correct.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"doxjplT2cu4dCrNjxgLXjRQ5fBd"},{"block_id":"doxjpip5VFt4It6wl7JqW342PEb","block_type":12,"bullet":{"elements":[{"text_run":{"content":"Go to the Email Records tab to check the sending status.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"doxjplT2cu4dCrNjxgLXjRQ5fBd"},{"block_id":"F5jwdC8CKoislyxoFonjACZHprh","block_type":27,"image":{"align":2,"height":572,"scale":1,"token":"StcGbnisloXhnqxNXbcjBmx6p9k","width":1280},"parent_id":"doxjplT2cu4dCrNjxgLXjRQ5fBd"},{"block_id":"OdrTdAp3qoZ9OExnhRajiJk1prS","block_type":27,"image":{"align":2,"height":567,"scale":1,"token":"VIImb0HRMoP4xdxghzWjfcZEpRb","width":1280},"parent_id":"doxjplT2cu4dCrNjxgLXjRQ5fBd"},{"block_id":"HDVtd2bqmoivqVx1rWcjj1ecpfb","block_type":27,"image":{"align":2,"height":1310,"scale":1,"token":"X31jbm0siofGfPxyF8ijugQgpOc","width":3022},"parent_id":"doxjplT2cu4dCrNjxgLXjRQ5fBd"},{"block_id":"K3rfd68jXojgwixKQEmju9pvppc","block_type":27,"image":{"align":2,"height":1322,"scale":1,"token":"LfNybNyQIoqNpuxamrqjVvYrpLh","width":2964},"parent_id":"doxjplT2cu4dCrNjxgLXjRQ5fBd"},{"block_id":"doxjpH28kmHN30eMMpucxkZo8ab","block_type":12,"bullet":{"elements":[{"text_run":{"content":"Submit (bulk operation available): After the operator's preliminary review confirms correctness, the application may be submitted to the next-node operator for review — the deposit entry operation.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"K3qdd1XEoor1t9xRePkjJNI8pah"},{"block_id":"doxjpaEBOTE0yO2fSnvSARSWZvG","block_type":12,"bullet":{"elements":[{"text_run":{"content":"Edit: If, during processing the transfer application, the operator learns from the client whether the broker has been notified or not, the operator can use the [Edit] button to modify the notification status so that the broker's awareness matches the actual situation.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"K3qdd1XEoor1t9xRePkjJNI8pah"},{"block_id":"FVEtdA6igoJx3fxYwHEjsSMipJb","block_type":27,"image":{"align":2,"height":1346,"scale":1,"token":"SHfDbwsAnopDDex3i22jLrk4pvd","width":2954},"parent_id":"K3qdd1XEoor1t9xRePkjJNI8pah"},{"block_id":"doxjpRSgtxdD6KEnPzQX50Q37Hg","block_type":12,"bullet":{"elements":[{"text_run":{"content":"Metric Cards","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"K3qdd1XEoor1t9xRePkjJNI8pah"},{"block_id":"doxjpn06BevrBE0GDRhWoRnQItb","block_type":2,"parent_id":"K3qdd1XEoor1t9xRePkjJNI8pah","text":{"elements":[{"text_run":{"content":"If a broker's securities transfer-in volume is high, the system's categorized display cards can be used for more granular operations. The left-to-right arrangement of the metric cards reflects the sequence of business operations.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"R9ojdGQ1xojqetxMFYnjBgE1prf","block_type":27,"image":{"align":2,"height":1330,"scale":1,"token":"KNJObwgmpoO5RyxHbQ2jvIHppFT","width":2988},"parent_id":"K3qdd1XEoor1t9xRePkjJNI8pah"},{"block_id":"doxjpCUQtmpdmertxEVnYp4UmIb","block_type":5,"heading3":{"elements":[{"text_run":{"content":"Deposit Details","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"K3qdd1XEoor1t9xRePkjJNI8pah"},{"block_id":"doxjpJGcpS9kl6FfgTUh6v0O1Xg","block_type":2,"parent_id":"K3qdd1XEoor1t9xRePkjJNI8pah","text":{"elements":[{"text_run":{"content":"Because a single deposit application may contain multiple security detail records, the deposit processing reviewer must carefully verify each deposit detail; only after approval may the deposit be entered.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"doxjpAIDglWjj0BkrPF465BHJ2b","block_type":12,"bullet":{"elements":[{"text_run":{"content":"Edit: If, during processing of security details, a specific detail record submitted by the user is found to be erroneous, it may be corrected via the [Edit] button after confirmation with the client.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"children":["CkMRdBHEToS3vcxklzKjopq9pPt","doxjpXjp1v3p8757HgQXZxQJ1Je"],"parent_id":"K3qdd1XEoor1t9xRePkjJNI8pah"},{"block_id":"CkMRdBHEToS3vcxklzKjopq9pPt","block_type":27,"image":{"align":2,"height":1244,"scale":1,"token":"VC4rb7uD0ofUnOx7vqNjo7Mspyf","width":3002},"parent_id":"doxjpAIDglWjj0BkrPF465BHJ2b"},{"block_id":"doxjpXjp1v3p8757HgQXZxQJ1Je","block_type":12,"bullet":{"elements":[{"text_run":{"content":"Editable fields: stock name, custodian code, sub-account number, security detail quantity, transfer cost, and settlement remarks.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"doxjpAIDglWjj0BkrPF465BHJ2b"},{"block_id":"doxjpkp4EW129yCZx1RQzbqUk4y","block_type":12,"bullet":{"elements":[{"text_run":{"content":"Delete: If the user indicates that a specific submitted detail will no longer be transferred, the target detail record can be removed via the [Delete] button.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"K3qdd1XEoor1t9xRePkjJNI8pah"},{"block_id":"doxjpqpdrmYWvnB4UaJriSL6Plg","block_type":12,"bullet":{"elements":[{"text_run":{"content":"Generate SI Instructions (bulk operation available): Because transfer-in operations require necessary SI information to be entered in CCASS, the \"Generate SI Instructions\" function can automatically save this required information as a file for users to upload to CCASS, avoiding manual entry in the CCASS system. Generated SI instructions can also be viewed and exported under the \"SI Instruction List\" menu.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"K3qdd1XEoor1t9xRePkjJNI8pah"},{"block_id":"NlWNdWfEvoxjbqxj1GqjcKp0ptc","block_type":27,"image":{"align":2,"height":1236,"scale":1,"token":"Fb75boLeeoJGiNxEDSijWuvDpUg","width":2992},"parent_id":"K3qdd1XEoor1t9xRePkjJNI8pah"},{"block_id":"Hd62dftXno2cnkx3Cx7jI4jLpBd","block_type":27,"image":{"align":2,"height":1304,"scale":1,"token":"GWvjba7LIouY6oxpKQZjKddnpvg","width":2970},"parent_id":"K3qdd1XEoor1t9xRePkjJNI8pah"},{"block_id":"doxjpu4AQnL0fOpmOt52I3a3rlb","block_type":12,"bu