{"obj_edit_time":"1775095438","blocks":[{"block_id":"QcRHdI4gqoOr3HxLd5uj9w1PpLh","block_type":1,"children":["doxjpSgdIEl5EkorWwfJGuIu6ZI","doxjp72HO0cgYXGZ4vg2A9EGDL1","doxjpO5v62V4XN3krQbZyAE8M5e","doxjp6XPlCjxRbv07DDPgRzYi9e","doxjprRhut74ijLHXidFH4YSe9f","doxjpQGc5ZTDSfRTkJ8agDkXFzb","doxjpxZwvP3PHCXwp3ee1bKQ8k4","doxjpSnQgxiXyIYGbW6NvDI76Fb","PoBodtgMEoQwJOxVXncjqL24pdf"],"page":{"elements":[{"text_run":{"content":"Business Overview","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1}},"parent_id":""},{"block_id":"doxjpSgdIEl5EkorWwfJGuIu6ZI","block_type":14,"code":{"elements":[{"text_run":{"content":"slug: CrtywiK2DiWR8pkAlstcM0K1ncf\ntitle: Business Introduction\n","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":"sidebar_position: 0","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"language":67,"wrap":false}},"parent_id":"QcRHdI4gqoOr3HxLd5uj9w1PpLh"},{"block_id":"doxjp72HO0cgYXGZ4vg2A9EGDL1","block_type":3,"heading1":{"elements":[{"text_run":{"content":"Overview","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"QcRHdI4gqoOr3HxLd5uj9w1PpLh"},{"block_id":"doxjpO5v62V4XN3krQbZyAE8M5e","block_type":2,"parent_id":"QcRHdI4gqoOr3HxLd5uj9w1PpLh","text":{"elements":[{"text_run":{"content":"In the back office of the securities system, the Bank Card Management feature plays a crucial role. The following are its main functions:","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"doxjp6XPlCjxRbv07DDPgRzYi9e","block_type":2,"parent_id":"QcRHdI4gqoOr3HxLd5uj9w1PpLh","text":{"elements":[{"text_run":{"content":"Fund Deposits and Withdrawals: ","text_element_style":{"bold":true,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":"Clients can use their bound bank cards to deposit or withdraw funds, enabling transfers between their securities accounts and bank accounts. This provides clients with an efficient way to manage their funds, allowing them to easily transfer funds into their securities accounts for investment or transfer funds back to their bank accounts when needed.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"doxjprRhut74ijLHXidFH4YSe9f","block_type":2,"parent_id":"QcRHdI4gqoOr3HxLd5uj9w1PpLh","text":{"elements":[{"text_run":{"content":"Real-name Authentication: ","text_element_style":{"bold":true,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":"When binding a bank card, clients are typically required to undergo real-name authentication to verify the authenticity and reliability of their identity. This helps maintain fairness, integrity, and transparency in the securities market, preventing illegal transactions and money laundering.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"doxjpQGc5ZTDSfRTkJ8agDkXFzb","block_type":2,"parent_id":"QcRHdI4gqoOr3HxLd5uj9w1PpLh","text":{"elements":[{"text_run":{"content":"Transaction Security:","text_element_style":{"bold":true,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":" ","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":"Fund transfers conducted through bank cards employ advanced encryption technologies and security measures to ensure the safety of funds during transactions. This helps protect clients' interests and prevents the misappropriation or loss of funds.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"doxjpxZwvP3PHCXwp3ee1bKQ8k4","block_type":2,"parent_id":"QcRHdI4gqoOr3HxLd5uj9w1PpLh","text":{"elements":[{"text_run":{"content":"Transaction Record Query: ","text_element_style":{"bold":true,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":"Clients can query their bank card transaction records through the back office of the securities system, including fund transfers in and out, deposits, withdrawals, and more. This helps clients understand their fund flows, facilitating financial management and decision-making.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"doxjpSnQgxiXyIYGbW6NvDI76Fb","block_type":2,"parent_id":"QcRHdI4gqoOr3HxLd5uj9w1PpLh","text":{"elements":[{"text_run":{"content":"Enhanced Transaction Efficiency:","text_element_style":{"bold":true,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":" ","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":"Automated bank card transactions reduce the need for manual intervention, improving transaction efficiency. Clients can complete fund transfers quickly, save time and effort, and better seize investment opportunities.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"PoBodtgMEoQwJOxVXncjqL24pdf","block_type":2,"parent_id":"QcRHdI4gqoOr3HxLd5uj9w1PpLh","text":{"elements":[{"text_run":{"content":"In short, the Bank Card Management feature plays an important role in the back office of the securities system, providing customers with a convenient, secure, and efficient way to manage their funds, thereby promoting the healthy development of the securities market.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}}]}