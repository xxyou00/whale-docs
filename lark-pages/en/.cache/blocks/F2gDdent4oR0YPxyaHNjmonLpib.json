ntent":"Q:","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":" What are the available deposit methods and channels?","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"doxjp7ia8nEmZf6FgOxxpQRBpRm","block_type":2,"parent_id":"F2gDdent4oR0YPxyaHNjmonLpib","text":{"elements":[{"text_run":{"content":"A:","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":" Common deposit methods include: ","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":"online banking transfer, wire transfer, bank-securities transfer, sub-account transfer, eDDA, Faster Payment System (FPS), cheque, ATM/bank counter, and PayNow.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"doxjpqXnjauHjmKpHYjbVBWc0KG","block_type":19,"callout":{"background_color":5,"border_color":5,"emoji_id":"question","text_color":1},"children":["doxjpYwernwg7kGjgcLMKJNOLHc"],"parent_id":"F2gDdent4oR0YPxyaHNjmonLpib"},{"block_id":"doxjpYwernwg7kGjgcLMKJNOLHc","block_type":2,"parent_id":"doxjpqXnjauHjmKpHYjbVBWc0KG","text":{"elements":[{"text_run":{"content":" ","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":"Q:","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":" ","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":"Why are client deposit applications approved instantly and reflected in the deposit records?","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"doxjpEC3tGK2qcxOuOZZc271qEe","block_type":2,"parent_id":"F2gDdent4oR0YPxyaHNjmonLpib","text":{"elements":[{"text_run":{"content":"A:","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":" ","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":"This happens because the deposit module supports direct API integration with the client app. If the client submits a deposit application via the API, the system will automatically review and deposit the funds.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"doxjpLH2NDlQIHKqeBn1tB7HAeg","block_type":19,"callout":{"background_color":5,"border_color":5,"emoji_id":"question","text_color":1},"children":["doxjp3fnGKZhsBfwUR0H8rZ2Xnd"],"parent_id":"F2gDdent4oR0YPxyaHNjmonLpib"},{"block_id":"doxjp3fnGKZhsBfwUR0H8rZ2Xnd","block_type":2,"parent_id":"doxjpLH2NDlQIHKqeBn1tB7HAeg","text":{"elements":[{"text_run":{"content":"Q:","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":" What is the difference between the \"Deposit Refund\" and \"Withdrawal Refund\" functions on the ","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":"Deposit Match","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":" page?","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"doxjpsob12PgMuXyakt5Sw7QfUh","block_type":2,"parent_id":"F2gDdent4oR0YPxyaHNjmonLpib","text":{"elements":[{"text_run":{"content":"A:","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":" \"Deposit Refund\" refers to","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":"the process of returning an incoming deposit to the client's original bank account","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":" \"Withdrawal Refund\" ","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":"occurs when a client's withdrawal is rejected by the beneficiary bank, and the funds are returned by the bank to the account, recorded as a bank inflow. This inflow record must be linked to the original withdrawal record to facilitate subsequent reconciliation.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":".","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"doxjpBgpnxzNNvBqCKglhi6TMBc","block_type":19,"callout":{"background_color":5,"border_color":5,"emoji_id":"question","text_color":1},"children":["doxjpIIkeWc0ZgT7Z3fcqzd67Ob"],"parent_id":"F2gDdent4oR0YPxyaHNjmonLpib"},{"block_id":"doxjpIIkeWc0ZgT7Z3fcqzd67Ob","block_type":2,"parent_id":"doxjpBgpnxzNNvBqCKglhi6TMBc","text":{"elements":[{"text_run":{"content":"Q:","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":" ","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":"If a Direct Deposit was completed without bank statement details, can I add this information later?","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"doxjplU14A6BucmyyvtmFeL2izb","block_type":2,"parent_id":"F2gDdent4oR0YPxyaHNjmonLpib","text":{"elements":[{"text_run":{"content":"A:","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":" Yes. ","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":"Click Import bank statements. In the pop-up window, download the template, fill in the required fields, and upload the file to supplement the bank statement details.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"H8jTdtOiZoSUFIxPJdujn6RJpxf","block_type":27,"image":{"align":2,"height":1236,"scale":1,"token":"MHWBbHjBCoZfWzx4TsFjZPtUpBf","width":3296},"parent_id":"F2gDdent4oR0YPxyaHNjmonLpib"}]}