needed.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"doxjp5PY4zyo7ihUWZxefRcGvAh","block_type":5,"heading3":{"elements":[{"text_run":{"content":"Currency Exchange Strategy","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"EWgtdSomVoTBwjxByXwjFQ3Wpsg"},{"block_id":"doxjpeRV7XT8NFEPWv8Eb5CecQb","block_type":2,"parent_id":"EWgtdSomVoTBwjxByXwjFQ3Wpsg","text":{"elements":[{"text_run":{"content":"This refers to the strategy that defines the entire process from client exchange request submission to execution. Currently, two strategies are supported: Exchange Pool and Bank Exchange. Specifically:","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"doxjpV1khv5O4sB00fNYZpexlne","block_type":30,"parent_id":"EWgtdSomVoTBwjxByXwjFQ3Wpsg","sheet":{"token":"FTAXsZoxbhhssKt3q65jkrEVpKg_JxC3IP"}},{"block_id":"doxjpBjt7fe1XmfzCPtJ4VIYGwf","block_type":12,"bullet":{"elements":[{"text_run":{"content":"Create an exchange strategy","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"EWgtdSomVoTBwjxByXwjFQ3Wpsg"},{"block_id":"doxjpnFHu5q8T1lm97Mj05HMlYz","block_type":2,"parent_id":"EWgtdSomVoTBwjxByXwjFQ3Wpsg","text":{"elements":[{"text_run":{"content":"Click Create. In the pop-up window, fill in the following fields sequentially: Service Strategy Setting → Exchange Type Setting → Applicable Time Period Setting → Channel Setting → Covered Currency Pairs Setting.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"PomHd1MHlo7PlmxTVCxjY94QpHf","block_type":27,"image":{"align":2,"height":1332,"scale":1,"token":"QiZcbdcTuo8FRYxkstJjq34NpIe","width":2948},"parent_id":"EWgtdSomVoTBwjxByXwjFQ3Wpsg"},{"block_id":"doxjpheIY6PAoQuWxv0tg6vNcwe","block_type":12,"bullet":{"elements":[{"text_run":{"content":"Notes:","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"children":["P2KXdIJ9Dokua1xFjUyjWZDeppg","doxjppJ8TI9ialRaiIPnVZ3CZUe"],"parent_id":"EWgtdSomVoTBwjxByXwjFQ3Wpsg"},{"block_id":"P2KXdIJ9Dokua1xFjUyjWZDeppg","block_type":12,"bullet":{"elements":[{"text_run":{"content":"Multiple service time periods can be selected, but they must not overlap. The system will apply the service strategy based on the time periods selected by the operator.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"doxjpheIY6PAoQuWxv0tg6vNcwe"},{"block_id":"doxjppJ8TI9ialRaiIPnVZ3CZUe","block_type":12,"bullet":{"elements":[{"text_run":{"content":"An exchange channel should only be selected when the service strategy is set to Bank Exchange.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"doxjpheIY6PAoQuWxv0tg6vNcwe"},{"block_id":"doxjpN5DDcAgUugbrIOEdObPUvd","block_type":2,"parent_id":"EWgtdSomVoTBwjxByXwjFQ3Wpsg","text":{"elements":[{"text_run":{"content":"After the exchange strategy is set, operators can click Edit and toggle the enable/disable switch to manage it according to actual business needs.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"GrjXdelQ8oISBSxZfu6jX3zTppf","block_type":27,"image":{"align":2,"height":1304,"scale":1,"token":"KCcIbQ9K8oN4rsx6os6jF9ARpQc","width":2908},"parent_id":"EWgtdSomVoTBwjxByXwjFQ3Wpsg"},{"block_id":"doxjpASPi6d6q4nS39H4QUOpFbe","block_type":5,"heading3":{"elements":[{"text_run":{"content":"Exchange Pool Quota Configuration","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"EWgtdSomVoTBwjxByXwjFQ3Wpsg"},{"block_id":"doxjp3UpLAFuLkoAbYazJeReCwc","block_type":2,"parent_id":"EWgtdSomVoTBwjxByXwjFQ3Wpsg","text":{"elements":[{"text_run":{"content":"To implement the Exchange Pool strategy, operators need to establish the exchange pool logic. This tab allows operators to add, delete, and modify exchange quotas, and continuously calculates the exchange pool balance based on the operator's executed exchange records.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"NIELdvqXhoDBVBx2OYoj7pHop6d","block_type":27,"image":{"align":2,"height":1300,"scale":1,"token":"SblgbM1aEo0IV3xK2pAjp3Nipwc","width":2946},"parent_id":"EWgtdSomVoTBwjxByXwjFQ3Wpsg"},{"block_id":"doxjpQqR1VsIi8mJpJcpMSdTWCe","block_type":12,"bullet":{"elements":[{"text_run":{"content":"Add (exchange pool quota): Set the exchange pool quota according to the currency. The configuration includes:","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"children":["doxjpC16dOY22VHBuuEkKIgxyZd","doxjpqtnmGX47wfmoAdDzWIbcxq"],"parent_id":"EWgtdSomVoTBwjxByXwjFQ3Wpsg"},{"block_id":"doxjpC16dOY22VHBuuEkKIgxyZd","block_type":12,"bullet":{"elements":[{"text_run":{"content":"Spread Amount: After the exchange quota for a certain currency is used up, the account balance of that currency must not fall below this amount.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"doxjpQqR1VsIi8mJpJcpMSdTWCe"},{"block_id":"doxjpqtnmGX47wfmoAdDzWIbcxq","block_type":12,"bullet":{"elements":[{"text_run":{"content":"Adjust Remaining Balance: As exchange business continues, operators can increase or decrease the corresponding quota according to actual business needs.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"doxjpQqR1VsIi8mJpJcpMSdTWCe"},{"block_id":"MiZCd07zRogS7RxNhgcjDzOrpxd","block_type":27,"image":{"align":2,"height":1318,"scale":1,"token":"TFCVbyPAHojciQxCwknjc5nCpkw","width":3016},"parent_id":"EWgtdSomVoTBwjxByXwjFQ3Wpsg"},{"block_id":"doxjp1HX3FHlBajRNyapE967jtd","block_type":5,"heading3":{"elements":[{"text_run":{"content":"Markup Setting","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"EWgtdSomVoTBwjxByXwjFQ3Wpsg"},{"block_id":"doxjpZMD0HpyFR9GaNkwPBgLYDc","block_type":2,"parent_id":"EWgtdSomVoTBwjxByXwjFQ3Wpsg","text":{"elements":[{"text_run":{"content":"As an intermediary platform for currency exchange, the broker may charge a fee on client exchange requests. The Markup Setting feature allows operators to apply a markup to either the reference exchange rate or the executed exchange rate, which serves as the broker's service fee.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"doxjpRQFyoLoAFNACNUOaN7wd9e","block_type":12,"bullet":{"elements":[{"text_run":{"content":"Add a markup: Click Add. In the pop-up window, set markups by currency pair based on the Ref Rate Source Channel.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"children":["SdUldXw4poPhhexqfwK