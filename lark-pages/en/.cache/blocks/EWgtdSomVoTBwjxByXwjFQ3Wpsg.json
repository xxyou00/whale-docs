ode":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false,"sequence":"auto"}},"parent_id":"EWgtdSomVoTBwjxByXwjFQ3Wpsg"},{"block_id":"doxjpsPvdcSQwYQFVa2q6LWOvFc","block_type":3,"heading1":{"elements":[{"text_run":{"content":"II. Operation Instructions","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"EWgtdSomVoTBwjxByXwjFQ3Wpsg"},{"block_id":"doxjpLY1CBQJjvvqueKNOacPd6U","block_type":4,"heading2":{"elements":[{"text_run":{"content":"Service Parameter","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"EWgtdSomVoTBwjxByXwjFQ3Wpsg"},{"block_id":"doxjpCDEyb5inGxXJbJqfAMX3zd","block_type":2,"parent_id":"EWgtdSomVoTBwjxByXwjFQ3Wpsg","text":{"elements":[{"text_run":{"content":"The Service Parameter module allows for the initial setup of the currency exchange function. Depending on the actual situation of the foreign exchange business, operators may need to complete this setup once or revisit it multiple times to ensure that exchanges are processed accurately and efficiently.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"doxjpV78fTnSI2SO4FKobTaN78g","block_type":19,"callout":{"background_color":5,"border_color":5,"emoji_id":"round_pushpin","text_color":1},"children":["doxjp3F7ZnpfN3hzPpuTL40Q4fh"],"parent_id":"EWgtdSomVoTBwjxByXwjFQ3Wpsg"},{"block_id":"doxjp3F7ZnpfN3hzPpuTL40Q4fh","block_type":2,"parent_id":"doxjpV78fTnSI2SO4FKobTaN78g","text":{"elements":[{"text_run":{"content":"Navigation: Service Parameter > Exchange","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"doxjpt