hange strategies, and exchange-pool quota settings. Operation features include frequently used functions such as manual exchange, reference rate markups, and the handling of exception exchange records.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"doxjpq9IHBGrBwkd8layYoqbOWh","block_type":2,"parent_id":"EWgtdSomVoTBwjxByXwjFQ3Wpsg","text":{"elements":[{"text_run":{"content":"The overall business process is as follows:","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"AZEydG5XIoDZZLxfe0Xj1uXRpkd","block_type":43,"board":{"token":"BEr4wte5Hhi5DHbSFxojUPMupLd"},"parent_id":"EWgtdSomVoTBwjxByXwjFQ3Wpsg"},{"block_id":"doxjp7xEQY5PKltzGH16B38Pyqb","block_type":2,"parent_id":"EWgtdSomVoTBwjxByXwjFQ3Wpsg","text":{"elements":[{"text_run":{"content":"System function architecture","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"SNIsdFbkOoDxDJxWjEmjKY0dpbd","block_type":43,"board":{"token":"AuaBwBcL4h1TFQb274oj4uOXpjb"},"parent_id":"EWgtdSomVoTBwjxByXwjFQ3Wpsg"},{"block_id":"doxjpQeHvX9wzf6bNw0Q5vnyzPg","block_type":4,"heading2":{"elements":[{"text_run":{"content":"Prerequisite","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"EWgtdSomVoTBwjxByXwjFQ3Wpsg"},{"block_id":"doxjpYAxyCG6fnleI8SZ4mYRwfb","block_type":13,"ordered":{"elements":[{"text_run":{"content":"First, enable the currency exchange switch for the currency.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"EWgtdSomVoTBwjxByXwjFQ3Wpsg"},{"block_id":"