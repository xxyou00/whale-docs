{"obj_edit_time":"1775037455","blocks":[{"block_id":"Jj5ldJQmKoEQq6x0MWyjZOG4p1g","block_type":1,"children":["doxjpsPcFMpIcOLo2vHxmZDENCb","doxjptKv4VRJjevoWdjhk22ivPg","doxjprwcmO8n4pf1f4ZfICVLo1g","doxjpCFuuwyvu4lj3alf1P3jaBg","doxjpbYKOm4UsuZ99lettkOcU4d","doxjpNC2AdZE7L9GN8n9sEROxbf","doxjpWVyRv6xl8I5JI3FZeDvPlf","doxjpPvdkUsJu3a0j4zeV1Q82Cg","doxjpgJr2SSx4A9ErnUrw59bxxh","doxjpiXGipaT0CbPwIBaqZ2b4Nf","QXOAdAIMYojtlQxF84Ej4GSbp8e","doxjphN4MofdnHtAJuEr30HfdV0","doxjppZLzxtlGehQpjGD7nTxJgb","doxjpWC14CG5iMYkzDdZZZ1vfSd"],"page":{"elements":[{"text_run":{"content":"Business Overview","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1}},"parent_id":""},{"block_id":"doxjpsPcFMpIcOLo2vHxmZDENCb","block_type":14,"code":{"elements":[{"text_run":{"content":"slug: SOClwYW0BiIkPKkQA6Dcq6rpndd\ntitle: Business Introduction\n","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":"sidebar_position: 0","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"language":67,"wrap":false}},"parent_id":"Jj5ldJQmKoEQq6x0MWyjZOG4p1g"},{"block_id":"doxjptKv4VRJjevoWdjhk22ivPg","block_type":3,"heading1":{"elements":[{"text_run":{"content":"Business Introduction","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"Jj5ldJQmKoEQq6x0MWyjZOG4p1g"},{"block_id":"doxjprwcmO8n4pf1f4ZfICVLo1g","block_type":3,"heading1":{"elements":[{"text_run":{"content":"Overview","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"Jj5ldJQmKoEQq6x0MWyjZOG4p1g"},{"block_id":"doxjpCFuuwyvu4lj3alf1P3jaBg","block_type":2,"parent_id":"Jj5ldJQmKoEQq6x0MWyjZOG4p1g","text":{"elements":[{"text_run":{"content":"Foreign exchange business refers to financial transactions involving the conversion of one currency into another. These transactions typically involve currencies from different countries or regions and serve a variety of purposes, including commercial trade, travel, investment, and risk management. Foreign exchange services can be conducted through banks, foreign exchange trading platforms, currency exchange institutions, and other channels.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"doxjpbYKOm4UsuZ99lettkOcU4d","block_type":3,"heading1":{"elements":[{"text_run":{"content":"Exchange Process","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}},"parent_id":"Jj5ldJQmKoEQq6x0MWyjZOG4p1g"},{"block_id":"doxjpNC2AdZE7L9GN8n9sEROxbf","block_type":2,"parent_id":"Jj5ldJQmKoEQq6x0MWyjZOG4p1g","text":{"elements":[{"text_run":{"content":"Basic process for withdrawals:","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"doxjpWVyRv6xl8I5JI3FZeDvPlf","block_type":2,"parent_id":"Jj5ldJQmKoEQq6x0MWyjZOG4p1g","text":{"elements":[{"text_run":{"content":"Client Submitting Withdrawal Request: ","text_element_style":{"bold":true,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":"The client submits a withdrawal request to the securities company through one of the available channels, such as an online platform, by telephone, or in person at a securities company's counter.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"doxjpPvdkUsJu3a0j4zeV1Q82Cg","block_type":2,"parent_id":"Jj5ldJQmKoEQq6x0MWyjZOG4p1g","text":{"elements":[{"text_run":{"content":"Identity Verification: ","text_element_style":{"bold":true,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":"The securities company verifies the client's identity. This usually requires the client to provide identification documents or other relevant identity verification information.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"doxjpgJr2SSx4A9ErnUrw59bxxh","block_type":2,"parent_id":"Jj5ldJQmKoEQq6x0MWyjZOG4p1g","text":{"elements":[{"text_run":{"content":"Confirm the source of funds for withdrawal: ","text_element_style":{"bold":true,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":"The securities company may request the client to provide supporting documents regarding the source of funds to ensure their legality and compliance.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"doxjpiXGipaT0CbPwIBaqZ2b4Nf","block_type":2,"parent_id":"Jj5ldJQmKoEQq6x0MWyjZOG4p1g","text":{"elements":[{"text_run":{"content":"Request Processing: ","text_element_style":{"bold":true,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":"After receiving the withdrawal request from the client, the securities company conducts an internal review and processing. They will verify the available balance in the client's account and the withdrawal amount to ensure compliance with requirements.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"QXOAdAIMYojtlQxF84Ej4GSbp8e","block_type":2,"parent_id":"Jj5ldJQmKoEQq6x0MWyjZOG4p1g","text":{"elements":[{"text_run":{"content":"Fund Transfer:","text_element_style":{"bold":true,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":" The securities company transfers the funds specified by the client to the designated account. This may involve fund transfer operations with financial institutions such as banks.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"doxjphN4MofdnHtAJuEr30HfdV0","block_type":2,"parent_id":"Jj5ldJQmKoEQq6x0MWyjZOG4p1g","text":{"elements":[{"text_run":{"content":"Confirmation Notice: ","text_element_style":{"bold":true,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":"Once the fund transfer is completed, the securities company sends a confirmation notice to the client, informing them that the withdrawal has been completed.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"doxjppZLzxtlGehQpjGD7nTxJgb","block_type":2,"parent_id":"Jj5ldJQmKoEQq6x0MWyjZOG4p1g","text":{"elements":[{"text_run":{"content":"Settlement","text_element_style":{"bold":true,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":": ","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":"The securities company performs internal account settlement to ensure that all records accurately reflect the completed withdrawal.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}},{"block_id":"doxjpWC14CG5iMYkzDdZZZ1vfSd","block_type":2,"parent_id":"Jj5ldJQmKoEQq6x0MWyjZOG4p1g","text":{"elements":[{"text_run":{"content":"Records and Reports: ","text_element_style":{"bold":true,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}},{"text_run":{"content":"The securities company records the withdrawal in the client's account and generates relevant reports. These records and reports support ongoing compliance monitoring and audits of withdrawals.","text_element_style":{"bold":false,"inline_code":false,"italic":false,"strikethrough":false,"underline":false}}}],"style":{"align":1,"folded":false}}}]}